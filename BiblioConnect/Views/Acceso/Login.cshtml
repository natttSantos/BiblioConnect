                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce una ciudad</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating" id="calle-field">
                                            <input type="text" class="form-control" id="Calle" placeholder="Calle">
                                            <label>Calle</label>
                                            <span class="error email error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce una calle</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating" id="codPostal-field">
                                            <input type="text" class="form-control" id="CodPostal" placeholder="Código Postal">
                                            <label>Código Postal</label>
                                            <span class="error email error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce un código postal de 5 dígitos</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating" id="password-field">
                                            <input type="password" class="form-control" id="Contraseña" placeholder="Contraseña">
                                            <label for="Nombre">Contraseña</label>
                                            <i class="bx bx-hide show-hide" id="showPassword"></i>
                                            <span class="error email error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Las contraseñas no coinciden</p>
                                            </span>
