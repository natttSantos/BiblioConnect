
@{
    ViewBag.Title = "Detalles Libro";
}
@using BiblioConnect.Modelo


<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    @* DataTables CSS BÁSICO *@
    <link href="~/Content/datatables.min.css" rel="stylesheet" />
    @* DataTables estilo Boostrap 5 CSS *@
    <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    @* CSS DE MAPAS *@
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" type="text/css" href="~/CSS/DetallesLibro.css" />
</head>

<body>
    <div id="libroContainer">
        <img id="Foto" src="#" alt="Imagen">
        <div id="TituloDescripcionContainer">
            <h3 id="Titulo"></h3>
            <div id="Descripcion"></div>
        </div>
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h6 id="Biblioteca"></h6>
                <p class="card-text" id="txtCard"></p>
                <button class="btn btn-primary" id="btnTransaccion"></button>
            </div>
        </div>
    </div>
    <div id="InformacionAdicional">
        <h6 id="Autor">Autor</h6>
        <h6 id="Categoria">Categoría</h6>
        <h6 id="Editorial">Editorial</h6>
    </div>
    <button id="btnBiblioteca">Ir a la biblioteca</button>

    @* JQquery, Popper.js, Boostrap.js *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    @* DataTable JS *@
    <script src="~/Scripts//datatables.min.js"></script>
    @* Jquery *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    @* JS DE MAPAS *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    @* Libreria alert *@
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="~/Scripts/sweetAlert.js"></script>
    @* FECHAS *@
    <script src="~/Scripts/Fechas.js"></script>

    <script>
        $(document).ready(function () {
            var oReserva;
            var duracion = 21;
            var IdLector = @(((Usuario)Session["Usuario"]).Id);
            var IdBiblioteca;

            $.ajax({
                url: "/Lector/ObtenerLibro",
                type: "GET",
                data: { id: @Model },
                success: function (data) {
                    var libro = data.data;
                    $("#Foto").attr("src", libro.Foto);
                    $("#Titulo").text(libro.Titulo);
                    IdBiblioteca = libro.idBiblioteca;

                     oReserva = {
                        idBiblioteca: IdBiblioteca,
                        idLector: IdLector,
                        idLibro: @Model,
                     };

                    getBiblioteca(IdBiblioteca),
                    tipoTransaccion(oReserva)
                    getAutor(libro.idAutor);
                    getCategoria(libro.idCategoria);
                    getEditorial(libro.idEditorial);
                    getDescription(libro.Titulo);

                },
                error: function (error) {
                    console.log("Error al obtener los datos del libro:", error);
                }
            });

            //Navigate to Perfil Biblioteca
            $("#btnBiblioteca").on("click", function () {
                if (IdBiblioteca) {
                    window.location.href = "/Biblioteca/Perfil?id=" + IdBiblioteca;
                }
            });
            // TRANSACCION
            $("#btnTransaccion").on("click", function () {
                //NUEVO CODIGO!!!

                 var oPrestamo = {
                    Estado: true,
                    IdBiblioteca: IdBiblioteca,
                    IdLector: IdLector,
                    IdLibro: @Model,
                    Duracion: duracion,
                };
                var btnTransaccion = $("#btnTransaccion");

                //REALIZAR PRÉSTAMO
                if (btnTransaccion.text() == "Préstamo") {
                    alertConfirm('¿Estás seguro de realizar el préstamo?',
                        'Si aceptas se te asignará como el próximo lector').then(() => {
                            registroPrestamo(oPrestamo);
                        })
                //REALIZAR RESERVA
                } else {
                    alertConfirm('¿Estás seguro de realizar una reserva?',
                        'Si aceptas se te añadirá a la lista de espera del ejemplar').then(() => {
                            registroReserva(oReserva);
                        })
                }
            });
        });

        function getPrestamo() {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: "/Lector/ObtenerPrestamo",
                    type: "GET",
                    data: { id: @Model },
                    success: function (data) {
                        var prestamo = data.data;
                        resolve(prestamo);
                    },
                    error: function (error) {
                        console.log("Error al obtener los datos del prestamo:", error);
                        reject(error);
                    }
                });
            });
        }

        function tipoTransaccion(oReserva) {
            $.ajax({
                url: "/Lector/ValidarTipoTransaccion",
                type: "GET",
                data: { id: @Model },
                success: function (resultado) {
                    var disponible = resultado.resultado;
                    var btnTransaccion = $("#btnTransaccion");
                    var txtCard = $('#txtCard');

                    if (disponible) {
                        txtCard.text("Disponible para préstamo. ¡Llévalo contigo!");
                        btnTransaccion.text("Préstamo");
                    } else {
                        getPrestamo().then(function (prestamo) {
                            txtCard.text("Próximo ejemplar disponible el " + getDate(prestamo.FechaDevolucion));
                        })
                        ValidarUsuarioRepetido(oReserva)
                        btnTransaccion.text("Reserva");
                    }
                },
                error: function (error) {
                    console.log("Error al obtener los datos del autor:", error);
                }
            });
        }

        function registroPrestamo(oPrestamo) {
            $.ajax({
                url: "/Lector/ObtenerUltimoPrestamo",
                type: "GET",
                data: { id: @Model },
                success: function (data) {
                    var prestamoAntiguo = data.data;
                    console.log(data); 
                    console.log(prestamoAntiguo)
                    //Primer préstamo para el libro
                    if (prestamoAntiguo.EstadoEntregado == null) {
                        console.log("No hay préstamos antiguos")
                        oPrestamo.EstadoEntregado = "Libro en perfectas condiciones";
                        //Hay préstamos antiguos
                    } else {
                        console.log("hay préstamos antiguos")
                        oPrestamo.EstadoEntregado = prestamoAntiguo.EstadoEntregado;
                    }
                    $.ajax({
                        url: '/Lector/RegistrarPrestamo',
                        type: 'POST',
                        data: oPrestamo,
                        success: function (data) {
                            alertSuccess('¡Enhorabuena!', 'Acabas de realizar un préstamo con éxito').then(() => {
                                location.reload(); //Recarga la página actual cuando se pulsa OK
                            })
                        },
                        error: function (error) {
                            console.log('Error al realizar el préstamo', error);
                        },
                    });
                },
                error: function (error) {
                    console.log("Error al obtener los datos del autor:", error);
                }
            });
        }
        function registroReserva(oReserva) {
            $.ajax({
                url: "/Lector/ObtenerUltimaFechaReserva",
                type: "GET",
                data: { id: @Model },
                success: function (data) {
                    var fechaAntigua = data.data;
                    getPrestamo().then(function (prestamo) {
                        //Primera reserva para el libro
                        if (fechaAntigua === "/Date(-62135596800000)/") {
                            console.log("No hay reservas antiguas")
                            oReserva.FechaReserva = getDate(prestamo.FechaDevolucion);
                        //Hay reservas antiguas
                        } else {
                            console.log("Hay reservas antiguas")
                            oReserva.FechaReserva = addDaysToDate(fechaAntigua, prestamo.Duracion);
                        }
                        $.ajax({
                            url: '/Lector/RegistrarReserva',
                            type: 'POST',
                            data: oReserva,
                            success: function (data) {
                                alertSuccess('¡Enhorabuena!', 'Acabas de realizar una reserva con éxito').then(() => {
                                })
                            },
                            error: function (error) {
                                console.log('Error al realizar el préstamo', error);
                            },
                        });
                    })
                },
                error: function (error) {
                    console.log("Error al obtener los datos del autor:", error);
                }
            });
        }
        function ValidarUsuarioRepetido(oReserva) {
            $.ajax({
                url: "/Lector/ValidarUsuarioRepetido",
                type: "GET",
                data: oReserva,
                success: function (resultado) {
                    var usuarioRepetido = resultado.resultado;
                    console.log(usuarioRepetido)
                    if (usuarioRepetido) {
                        console.log("entra en result")
                        var btnTransaccion = $("#btnTransaccion");
                        btnTransaccion.prop("disabled", true);
                    }
                },
                error: function (error) {
                    console.log("Error al validar usuario repetido:", error);
                }
            });
        }
        function ValidarPrimerPrestamo(idLibro) {
            $.ajax({
                url: "/Lector/ValidarPrimerPrestamo",
                type: "GET",
                data: { id: idLibro },
                success: function (data) {
                    var resultado = resultado.resultado;
                    return resultado;
                },
                error: function (error) {
                    console.log("Error al validar si es el primer prestamo:", error);
                }
            });
        }
        function getAutor(idAutor) {
            $.ajax({
                url: "/Lector/ObtenerAutor",
                type: "GET",
                data: { id: idAutor },
                success: function (data) {
                    var autor = data.data;
                    $("#Autor").text("Autor: " + autor.Nombre);
                },
                error: function (error) {
                    console.log("Error al obtener los datos del autor:", error);
                }
            });
        }
        function getCategoria(idCategoria) {
            $.ajax({
                url: "/Lector/ObtenerCategoria",
                type: "GET",
                data: { id: idCategoria },
                success: function (data) {
                    var categoria = data.data;
                    $("#Categoria").text("Categoría: "+categoria.Nombre);
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Categoria:", error);
                }
            });
        }
        function getEditorial(idEditorial) {
            $.ajax({
                url: "/Lector/ObtenerEditorial",
                type: "GET",
                data: { id: idEditorial },
                success: function (data) {
                    var editorial = data.data;
                    $("#Editorial").text("Editorial: " + editorial.Nombre);
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Editorial:", error);
                }
            });
        }
        function getBiblioteca(idBiblioteca) {
            $.ajax({
                url: "/Lector/ObtenerBiblio",
                type: "GET",
                data: { id: idBiblioteca },
                success: function (data) {
                    var biblioteca = data.data;
                    $("#Biblioteca").text(biblioteca.Nombre);
                    $("#btnBiblioteca").attr("data-idbiblioteca", idBiblioteca);
                    $("#btnTransaccion").attr("data-idbiblioteca", idBiblioteca);
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Biblioteca:", error);
                }
            });
        }

        function getDescription(title) {
        $.ajax({
            url: "https://www.googleapis.com/books/v1/volumes",
            data: { q: "intitle:" + title },
            dataType: "json",
            success: function (data) {
                if (data.items && data.items.length > 0) {
                    var book = data.items[0];
                    var summary = book.searchInfo.textSnippet;
                    $("#Descripcion").text(summary);
                } else {
                    $("#Descripcion").text("No se encontró ningún resumen para el libro.");
                }
            },
            error: function () {
                $("#description").text("Error al obtener la descripción del libro.");
            }
        });
        }
    </script>
</body>

