
@{
    ViewBag.Title = "Detalles Libro";
}
@using BiblioConnect.Modelo


<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    @* CSS DE MAPAS *@
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" type="text/css" href="~/CSS/Detalles.css" />

</head>

<body>
    <div id="libroContainer">
        <img id="FotoLibro" src="#" alt="Imagen">
        <div id="TituloDescripcionContainer">
            <h3 id="Titulo"></h3>
            @*<div id="Descripcion"></div>*@
        </div>
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h6 id="Biblioteca"></h6>
                <p class="card-text" id="txtCard"></p>
                <button class="btn btn-primary" id="btnTransaccion"></button>
            </div>
        </div>
    </div>
    <div id="InformacionAdicional">
        <button id="btnBiblioteca">Ir a la biblioteca</button>
        <h6 id="Autor"></h6>
        <h6 id="Categoria"></h6>
        <h6 id="Editorial"></h6>
        <h6 id="Idioma"></h6>
    </div>

    <div id="tabDetalles">
        <ul class="nav nav-tabs">
            <li class="nav-item">
                <a class="nav-link active" href="#descripcionLibro">Descripción general</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#descripcionAutor">Sobre el autor</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#infoAdicional">Información adicional</a>
            </li>
            <li class="nav-item">
                <a class="nav-link" href="#reseñas">Reseñas</a>
                <button id="botonEscribirReseña" type="button" class="btn btn-primary" style="display: none;" data-toggle="modal" data-target="#modalReseña">
                    Escribir reseña
                </button>
                <div id="reseñas-list"></div>

            </li>
        </ul>
        <div id="descripcionLibro" class="descripcion"></div>
        <div id="descripcionAutor" class="descripcion"></div>
    </div>

    @* MODAL RESEÑA *@

    <div class="modal" id="modalReseña" data-backdrop="static" data-keyboard="false" tabindex="-1" aria-labelledby="staticBackdropLabel" aria-hidden="true">
        <div class="modal-dialog" role="document">
            <div class="modal-content">
                <div class="modal-header bg-primary text-white">
                    <h5 class="modal-title" id="exampleModalLabel">Editorial</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <div class="form-group">
                        <label for="descripcion">Descripción:</label>
                        <textarea id="descripcion" name="descripcion" rows="4" cols="70" class="form-control"></textarea>
                    </div>
                    <div class="form-group">
                        <label for="puntuacion">Puntuación:</label>
                        <div class="rating">
                            <input type="radio" id="star5" name="puntuacion" value="5" /><label for="star5" title="5 estrellas"></label>
                            <input type="radio" id="star4" name="puntuacion" value="4" /><label for="star4" title="4 estrellas"></label>
                            <input type="radio" id="star3" name="puntuacion" value="3" /><label for="star3" title="3 estrellas"></label>
                            <input type="radio" id="star2" name="puntuacion" value="2" /><label for="star2" title="2 estrellas"></label>
                            <input type="radio" id="star1" name="puntuacion" value="1" /><label for="star1" title="1 estrella"></label>
                        </div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cerrar</button>
                    <button type="button" class="btn btn-primary" onclick="EnviarReseña()">Enviar</button>
                </div>
            </div>
        </div>
    </div>

</body>


@* JQquery, Popper.js, Boostrap.js *@
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="~/Scripts/bootstrap.js"></script>
@* Libreria alert *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Scripts/sweetAlert.js"></script>
@* JS DE MAPAS *@
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
@* FECHAS *@
<script src="~/Scripts/Fechas.js"></script>

<script>
    $(document).ready(function () {
            var oReserva;
            var duracion = 21;
            var IdLector = @(((Usuario)Session["Usuario"]).Id);
            var IdBiblioteca;
            var Titulo;

            $.ajax({
                url: "/Lector/ObtenerLibro",
                type: "GET",
                data: { id: @Model },
                success: function (data) {
                    var libro = data.data;
                    $("#FotoLibro").attr("src", libro.Foto);
                    $("#Titulo").text(libro.Titulo);
                    $("#Idioma").text("Idioma: " +libro.Idioma);
                    IdBiblioteca = libro.idBiblioteca;
                    Titulo = libro.Titulo;

                     oReserva = {
                        idBiblioteca: IdBiblioteca,
                        idLector: IdLector,
                        idLibro: @Model,
                        Estado: "En espera",
                     };

                    getBiblioteca(IdBiblioteca),
                    tipoTransaccion(oReserva)
                    getAutor(libro.idAutor);
                    getCategoria(libro.idCategoria);
                    getEditorial(libro.idEditorial);

                    // Asignar el título como atributo de datos al enlace del tab
                    $("a.nav-link").data("titulo", Titulo);

                },
                error: function (error) {
                    console.log("Error al obtener los datos del libro:", error);
                }
            });

           //TABS
            var primerElemento = $("a.nav-link").first();
            var identificadorDiv = primerElemento.attr("href");
            mostrarContenido(identificadorDiv);

            $("a.nav-link").on("click", function () {
                var identificadorDiv = $(this).attr("href"); // Obtener el identificador del div de descripción asociado al tab
                mostrarContenido(identificadorDiv);
            });

            $("#botonEscribirReseña").on("click", function () {
                $('#modalReseña').modal('show');
            });
            //Navigate to Perfil Biblioteca
            $("#btnBiblioteca").on("click", function () {
                if (IdBiblioteca) {
                    window.location.href = "/Biblioteca/Perfil?id=" + IdBiblioteca;
                }
            });
            // TRANSACCION
            $("#btnTransaccion").on("click", function () {
                var oPrestamo = {
                    Estado: true,
                    IdBiblioteca: IdBiblioteca,
                    IdLector: IdLector,
                    IdLibro: @Model,
                    Duracion: duracion,
                };
                var btnTransaccion = $("#btnTransaccion");

                //REALIZAR PRÉSTAMO
                if (btnTransaccion.text() == "Préstamo") {
                    alertConfirm('¿Estás seguro de realizar el préstamo?',
                        'Si aceptas se te asignará como el próximo lector').then(() => {
                            registroPendienteRecogida(oPrestamo);
                        })
                //REALIZAR RESERVA
                } else {
                    alertConfirm('¿Estás seguro de realizar una reserva?',
                        'Si aceptas se te añadirá a la lista de espera del ejemplar').then(() => {
                            registroReserva(oReserva);
                        })
                }
            });
        });

    // Función para mostrar el contenido correspondiente al elemento
    function mostrarContenido(identificadorDiv) {
        $("a.nav-link").removeClass("active"); // Remover la clase "active" de todos los elementos de la lista de pestañas
        $(`a[href="${identificadorDiv}"]`).addClass("active"); // Agregar la clase "active" al elemento de la lista de pestañas seleccionado
        $(".descripcion").empty(); // Vaciar el contenido de todas las descripciones para que no haya sobreescrituras

        if (identificadorDiv === "#descripcionLibro") {
            var tituloLibro = $("a.nav-link.active").data("titulo");
            getDescripcionLibro(tituloLibro);
        }
        if (identificadorDiv === "#descripcionAutor") {
            var nombreAutor = $("a.nav-link.active").data("autor");
            getDescripcionAutor(nombreAutor);
        }
        if (identificadorDiv === "#reseñas") {
            $("#botonEscribirReseña").show()
            getReseñas()
        }
    }

    function EnviarReseña() {
        var oReseña = {
            Descripcion: $("#descripcion").val(),
            Puntuacion: $("input[name='puntuacion']:checked").val(),
            idLibro: @Model,
            idLector: @(((Usuario)Session["Usuario"]).Id)
        }
        $.ajax({
            url: "/Lector/RegistrarReseña",
            type: "POST",
            data: oReseña,
            success: function (data) {
                alertSuccess('¡Enhorabuena!', 'Acabas de escribir una reseña.').then(() => {
                    window.location.reload();
                })
            },
            error: function (error) {
                console.log("Error al obtener los datos del prestamo:", error);
                reject(error);
            }
        });
    }
function getReseñas() {
    var idLibro = @Model;
    $.ajax({
        url: "/Lector/ListarReseñasPorLibro",
        type: "GET",
        data: { id: idLibro },
        success: function (data) {
            $("#reseñas-list").empty(); // Eliminar contenido previo
            $.each(data.data, function (index, reseña) {
                mostrarInfoReseña(reseña);
            });
        },
        error: function (error) {
            console.log("Error al obtener las reseñas:", error);
        }
    });
}

    function mostrarInfoReseña(reseña) {
        getLector(reseña.idLector).then(function (lector) {
            var estrellasHTML = "";
            for (var i = 1; i <= 5; i++) {
                var icono = i <= reseña.Puntuacion ? "fas fa-star" : "far fa-star";
                estrellasHTML += '<i class="' + icono + '"></i>';
            }

            var vistaReseña =
                '<div class="reseña">' +
                '  <div class="lector">' +
                '    <img src="' + lector.Foto + '" ' +
                '    <span>' + lector.Nombre + '</span>' +
                '  </div>' +
                '  <div class="contenido">' +
                '    <div class="descripcion">' + reseña.Descripcion + '</div>' +
                '    <div class="puntuacion">' + estrellasHTML + '</div>' +
                '    <div class="fecha">' + getDate(reseña.Fecha) + '</div>' +
                '  </div>' +
                '</div>';

            $("#reseñas-list").append(vistaReseña);
        });
    }


        function getPrestamo() {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: "/Lector/ObtenerPrestamo",
                    type: "GET",
                    data: { id: @Model },
                    success: function (data) {
                        var prestamo = data.data;
                        resolve(prestamo);
                    },
                    error: function (error) {
                        console.log("Error al obtener los datos del prestamo:", error);
                        reject(error);
                    }
                });
            });
        }

        function tipoTransaccion(oReserva) {
            $.ajax({
                url: "/Lector/ValidarTipoTransaccion",
                type: "GET",
                data: { id: @Model },
                success: function (resultado) {
                    var disponible = resultado.resultado;
                    var btnTransaccion = $("#btnTransaccion");
                    var txtCard = $('#txtCard');

                    if (disponible) {
                        txtCard.text("Disponible para préstamo. ¡Llévalo contigo!");
                        btnTransaccion.text("Préstamo");
                    } else {
                        txtCard.text("El ejemplar no está disponible, resérvalo y te avisaremos cuando lo esté.");
                        //getPrestamo().then(function (prestamo) {
                        //    txtCard.text("El ejemplar no está disponible, resérvalo y te avisaremos cuando lo esté.");
                        //    //txtCard.text("Próximo ejemplar disponible el " + getDate(prestamo.FechaDevolucion));
                        //})
                        ValidarUsuarioRepetido(oReserva)
                        btnTransaccion.text("Reserva");
                    }
                },
                error: function (error) {
                    console.log("Error al obtener los datos del autor:", error);
                }
            });
        }

        function registroPendienteRecogida(oPrestamo) {
            $.ajax({
                url: '/Lector/RegistrarPendienteRecogida',
                type: 'POST',
                data: oPrestamo,
                success: function (data) {
                    alertSuccess('¡Enhorabuena!', 'Acabas de realizar un préstamo con éxito. Ya puedes ir a recogerlo a la biblioteca.').then(() => {
                        location.reload(); //Recarga la página actual cuando se pulsa OK
                    })
                },
                error: function (error) {
                    console.log('Error al realizar el préstamo', error);
                },
            });
        }
        function registroReserva(oReserva) {
             $.ajax({
                url: '/Lector/RegistrarReserva',
                type: 'POST',
                data: oReserva,
                success: function (data) {
                    alertSuccess('¡Enhorabuena!', 'Acabas de realizar una reserva con éxito').then(() => {
                    })
                },
                error: function (error) {
                    console.log('Error al realizar el préstamo', error);
                },
            });
        }
        function ValidarUsuarioRepetido(oReserva) {
            $.ajax({
                url: "/Lector/ValidarUsuarioRepetido",
                type: "GET",
                data: oReserva,
                success: function (resultado) {
                    var usuarioRepetido = resultado.resultado;
                    console.log(usuarioRepetido)
                    if (usuarioRepetido) {
                        console.log("entra en result")
                        var btnTransaccion = $("#btnTransaccion");
                        btnTransaccion.prop("disabled", true);
                    }
                },
                error: function (error) {
                    console.log("Error al validar usuario repetido:", error);
                }
            });
        }
        function ValidarPrimerPrestamo(idLibro) {
            $.ajax({
                url: "/Lector/ValidarPrimerPrestamo",
                type: "GET",
                data: { id: idLibro },
                success: function (data) {
                    var resultado = resultado.resultado;
                    return resultado;
                },
                error: function (error) {
                    console.log("Error al validar si es el primer prestamo:", error);
                }
            });
        }
        function getAutor(idAutor) {
            $.ajax({
                url: "/Lector/ObtenerAutor",
                type: "GET",
                data: { id: idAutor },
                success: function (data) {
                    var autor = data.data;
                    $("#Autor").text("Autor: " + autor.Nombre);
                    // Atributo de datos al enlace del tab
                    $("a.nav-link").data("autor", autor.Nombre);
                },
                error: function (error) {
                    console.log("Error al obtener los datos del autor:", error);
                }
            });
        }
        function getCategoria(idCategoria) {
            $.ajax({
                url: "/Lector/ObtenerCategoria",
                type: "GET",
                data: { id: idCategoria },
                success: function (data) {
                    var categoria = data.data;
                    $("#Categoria").text("Categoría: "+categoria.Nombre);
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Categoria:", error);
                }
            });
        }
        function getEditorial(idEditorial) {
            $.ajax({
                url: "/Lector/ObtenerEditorial",
                type: "GET",
                data: { id: idEditorial },
                success: function (data) {
                    var editorial = data.data;
                    $("#Editorial").text("Editorial: " + editorial.Nombre);
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Editorial:", error);
                }
            });
        }
        function getBiblioteca(idBiblioteca) {
            $.ajax({
                url: "/Lector/ObtenerBiblio",
                type: "GET",
                data: { id: idBiblioteca },
                success: function (data) {
                    var biblioteca = data.data;
                    $("#Biblioteca").text(biblioteca.Nombre);
                    $("#btnBiblioteca").attr("data-idbiblioteca", idBiblioteca);
                    $("#btnTransaccion").attr("data-idbiblioteca", idBiblioteca);
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Biblioteca:", error);
                }
            });
        }

    function getLector(idLector) {
        console.log(idLector)
        return new Promise((resolve, reject) => {
        $.ajax({
            url: "/Lector/ObtenerLector",
            type: "GET",
            data: { id: idLector },
            success: function (data) {
                var lector = data.data;
                resolve(lector);
            },
            error: function (error) {
                console.log("Error al obtener los datos del lector:", error);
            }
        });
        });
    }
    function getDescripcionLibro(title) {
        console.log(title)
            $.ajax({
                url: "https://es.wikipedia.org/w/api.php",
                dataType: "jsonp",
                data: {
                    action: "query",
                    format: "json",
                    prop: "extracts",
                    exintro: true,
                    explaintext: true,
                    titles: title
                },
                success: function (response) {
                    var pages = response.query.pages;
                    var pageId = Object.keys(pages)[0];
                    var extract = pages[pageId].extract;

                    if (extract) {
                        var cleanExtract = extract.replace(/[\[\(].*?[\]\)]/g, ""); //Expresión regular evitar los paréntesis y corchetes
                        $("#descripcionLibro").text(cleanExtract);
                    } else {
                        $("#descripcionLibro").text("No se encontró ninguna sinopsis para el libro.");
                    }
                },
                error: function () {
                    $("#descripcionLibro").text("Error al obtener la sinopsis del libro.");
                }
            });
    }
    function getDescripcionAutor(autor) {
        $.ajax({
            url: "https://es.wikipedia.org/w/api.php",
            dataType: "jsonp",
            data: {
                action: "query",
                format: "json",
                prop: "extracts",
                exintro: true,
                explaintext: true,
                titles: autor
            },
            success: function (response) {
                var pages = response.query.pages;
                var pageId = Object.keys(pages)[0];
                var extract = pages[pageId].extract;

                if (extract) {
                    var cleanExtract = extract.replace(/[\[\(].*?[\]\)]/g, ""); // Regular expression to remove parentheses and brackets
                    $("#descripcionAutor").text(cleanExtract);
                } else {
                    $("#descripcionAutor").text("No se encontró ninguna información sobre el autor del libro.");
                }
            },
            error: function () {
                $("#descripcionAutor").text("Error al obtener la información sobre el autor del libro.");
            }
        });
    }



</script>