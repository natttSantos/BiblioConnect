<!DOCTYPE html>
<html lang="es">
@using BiblioConnect.Modelo
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Calendario a Full</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">

    <link rel="stylesheet" href="~/FullCalendar/main.css">
    <link rel="stylesheet" href="~/CSS/Calendario.css">
    <link rel="stylesheet" href="~/CSS/Modal.css">
</head>
<body>
    <div id="calendar"></div>

    <div class="modal fade" id="modal" tabindex="-1" aria-labelledby="registroModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable custom-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="registroModalLabel">Análisis del evento</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close" id="cerrar"></button>
                </div>
                <div class="modal-body">
                    <input id="txtid" type="hidden" value="0" />
                    <div class="row justify-content-center">
                            <label id="titulo" class="tituloEvento"></label>                       
                    </div>

                    <div class="row justify-content-center mt-3">
                            <label id="fecha"></label>
                    </div>
                    <div class="row justify-content-center">
                            <lsolabel id="hora"></lsolabel>
                    </div>
                    <div class="row mt-3 mb-4">
                        <div class="col-md-12 col-12">
                            <label>Descripción del evento:</label>
                            <textarea class="form-control" id="descripcionEvento" placeholder="Descripción del evento"></textarea>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @* JQquery, Popper.js, Boostrap.js *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>

    @* CALENDARIO *@
    <script src="~/FullCalendar/main.js"></script>
    <script src="~/FullCalendar/es.js"></script>
    <script src="~/Scripts/Fechas.js" charset="UTF-8"></script>

    <script>
        $(document).ready(function () {
            var calendarDiv = document.getElementById('calendar');

            var calendar = new FullCalendar.Calendar(calendarDiv, {
                locales: 'es', //iDioma (español)
                initialView: 'dayGridMonth',
                headerToolbar: {
                    left: 'today,prev,next',
                    center: 'title',
                    right: 'dayGridMonth,timeGridWeek,timeGridDay,listMonth',

                }, buttonText: { //Cambiamos los nombres de los botonews
                    today: 'Hoy',
                    month: 'Mes',
                    week: 'Semana',
                    day: 'Dia',
                    list: 'Listado'
                }, events: recuperarEventos(),
                dateClick: function (info) {

                }, eventClick: (info) => {
                    console.log(info.event._def.title);
                    var tituloSelected = info.event._def.title;

                    getEvento(tituloSelected).then(function (evento) {
                        document.getElementById('titulo').innerText = evento.Tipo + " con " + evento.NombreAutor;
                        $("#fecha").html('<i class="far fa-calendar-alt"></i> ' + formatDateToReadable(evento.FechaRealizacion));
                        $("#hora").html('<i class="far fa-clock"></i>' + " "+ evento.HoraInicio + "-" + evento.HoraFin);
                        document.getElementById('descripcionEvento').value = evento.DescripcionEvento;
                        abrirModal();
                    })
                }, firstDay: 1
            });
            calendar.render();
        })
        var botonCerrar = document.getElementById('cerrar');
        botonCerrar.addEventListener('click', () => {
            cerrarModal();
            // añadimos aquí vaciarCampos ya que sino al ver un evento y añadir otro se verá:
            vaciarCampos();
        });

        function cerrarModal() {
            modal.style.cssText += 'opacity: 0; transition: 0.5s';
            window.setTimeout(() => {
                modal.style.cssText = 'display: none';
            }, 500);
        }
function recuperarEventos() {
    var listaEventos = [];
    $.ajax({
        url: "/Biblioteca/ListarEventoPorBiblio",
        dataType: "json",
        data: { id: @(((Usuario)Session["Usuario"]).Id) },
        async: false,
        success: function (data) {
            $.each(data.data, function (index, evento) {
              /*  var backgroundColor = setBackgroundColor(evento);*/
                var nuevoEvento = {
                    title: evento.Tipo + " con " + evento.NombreAutor,
                    start: getDateFormatCalendar(evento.FechaRealizacion) + " " + evento.HoraInicio,
                    end: getDateFormatCalendar(evento.FechaRealizacion) + " " + evento.HoraFin,
                  /*  backgroundColor: backgroundColor,*/
                    extendedProps: {
                        eventoTipo: evento.Tipo // Almacenamos el tipo de evento en extendedProps
                    }
                };
                listaEventos.push(nuevoEvento);
            });
        },
        error: function () {
            console.log("Error al obtener los eventos.");
        }
    });
    return listaEventos;
        }

        //function setBackgroundColor(evento) {
        //    console.log(evento)
        //    if (evento.Tipo === 'Presentación libro') {
        //        backgroundColor = '#EE3520 ';
        //    } if (evento.Tipo === 'Firma de libro') {
        //        backgroundColor = '#277ab1';
        //    } if (evento.Tipo === 'Conferencia') {
        //        backgroundColor = '#C038BE ';
        //    } if (evento.Tipo === 'Club de lectura') {
        //        backgroundColor = 'green';
        //    } if (evento.Tipo === 'Taller escritura') {
        //        backgroundColor = '#F29908 ';
        //    }
        //    return backgroundColor;
        //}
        function getEvento(titulo) {
            return new Promise(function (resolve, reject) {
                $.ajax({
                url: "/Biblioteca/ListarEventoPorBiblio",
                dataType: "json",
                data: { id: @(((Usuario)Session["Usuario"]).Id) },
                async: false,
                success: function (data) {
                    $.each(data.data, function (index, evento) {
                        tituloCalendar = evento.Tipo + " con " + evento.NombreAutor;
                        console.log("Array: "+tituloCalendar)
                        if (titulo == tituloCalendar) {
                            console.log("COINCIDEN")
                            resolve(evento);
                        }
                    });
                },
                error: function () {
                    console.log("Error al obtener los eventos.");
                }
            });
          })
        }
        function mostrarModal(date) {
            var eventosDelDia = calendar.getEvents(function (evento) {
                return evento.start.toISOString().slice(0, 10) === date.toISOString().slice(0, 10);
            });

            if (eventosDelDia.length > 0) {
                var modal = $('#modalEventos');
                var modalBody = modal.find('.modal-body');
                modalBody.empty();

                $.each(eventosDelDia, function (index, evento) {
                    var eventoInfo = $('<p>').text(evento.title);
                    modalBody.append(eventoInfo);
                });

                modal.modal('show');
            }
        }
        function abrirModal() {
            modal.style.cssText = "display: flex;";
            window.setTimeout(() => {
                modal.style.cssText += "opacity: 1; transition: 0.5s";
            }, 10);
        }


    </script>
</body>
</html>