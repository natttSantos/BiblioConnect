<!DOCTYPE html>
@using BiblioConnect.Modelo
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="~/CSS/Notificacion.css" rel="stylesheet" />
    <link href="~/CSS/Layout.css" rel="stylesheet" />
    <!-- CSS only -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/next-sidebar@1/assets/css/next-sidebar.min.css">

</head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<body class="app is-collapsed">
    @* BIBLIOTECA NAVRBAR *@
    @{ Usuario oUsuario = Session["Usuario"] as Usuario;
        String tipoUsuario = oUsuario.TipoUsuario;
        int Id = oUsuario.Id;
        if (tipoUsuario.Equals("biblioteca"))
        {
            <div class="sidebar">
                <div class="sidebar-inner">
                    <div class="sidebar-logo">
                        <div class="d-flex align-items-center flex-nowrap">
                            <a class="sidebar-link text-decoration-none" href="#">
                                <div class="d-flex align-items-center flex-nowrap">
                                    <div class="logo-sm">
                                        <div class="logo d-flex align-items-center justify-content-center">
                                            <img src="~/images/LogoAppWeb.png">
                                        </div>
                                    </div>
                                    <div class="logo-text d-flex align-items-center justify-content-center">
                                        <img src="~/images/LogoAppWeb.png">
                                    </div>
                                </div>
                            </a>
                            <div class="">
                                <div class="mobile-toggle sidebar-toggle">
                                    <a href="#" class="text-decoration-none">
                                        <i class="far fa-times-circle"></i>
                                    </a>
                                </div>
                            </div>
                        </div>
                    </div>

                    <ul class="sidebar-menu scrollable position-relative">
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="/Biblioteca/Dashboard">
                                <span class="icon-holder">
                                    <i class="fas fa-chart-bar"></i>
                                </span>
                                <span class="title">Dashboard</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="/Biblioteca/Perfil?id=@Id">
                                <span class="icon-holder">
                                    <i class="fas fa-user"></i>
                                </span>
                                <span class="title">Perfil</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="/Biblioteca/Calendario">
                                <span class="icon-holder">
                                    <i class="far fa-calendar-alt"></i>
                                </span>
                                <span class="title">Calendario</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="/Biblioteca/Libros">
                                <span class="icon-holder">
                                    <i class="fas fa-book"></i>
                                </span>
                                <span class="title">Libro</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="/Biblioteca/Evento">
                                <span class="icon-holder">
                                    <i class="fas fa-person-booth"></i>
                                </span>
                                <span class="title">Evento</span>
                            </a>
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="/Biblioteca/Prestamo">
                                <span class="icon-holder">
                                    <i class="fas fa-american-sign-language-interpreting"></i>
                                </span>
                                <span class="title">Préstamos</span>
                            </a>
                        </li>
                    </ul>
                </div>
            </div>
        }

        @* LECTOR NAVRBAR *@
        else
        {
            <nav>
                <div>
                    <input type="checkbox" id="check">
                    <label for="check" class="checkbtn">
                        <i class="fas fa-bars"></i>
                    </label>
                    <a href="#" class="enlaceLogo">
                        <img src="~/images/LogoAppWebBlanco.png" alt="" class="logo" />
                    </a>
                    <ul>
                        <li>
                            <a class="active" href="/Lector/Inicio">Inicio</a>
                        </li>
                        <li>
                            <a href="/Lector/CatalogoLibros">Catálogo</a>
                        </li>
                        <li>
                            <a href="/Lector/CatalogoEventos">Eventos</a>
                        </li>
                        <li>
                            <a href="/Biblioteca/Perfil">Reservas</a>
                        </li>
                        <li class="nav-item">
                            <a href="/Lector/Notificaciones" class="nav-link">
                                <i class="fas fa-bell iconoNotificacion"></i>
                                <span id="notificationCount"></span> 
                            </a>
                            @*<div class="dropdown-menu dropdown-menu-right" aria-labelledby="notificationsDropdown">
                                <ul id="notificationList"></ul>
                            </div>*@
                        </li>
                        <li class="nav-item dropdown">
                            <a class="nav-link" href="#" id="perfilLector" role="button" data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">                             
                                <i class="fas fa-user-circle iconoUser"></i>
                                @*@{ String nombre = oUsuario.Nombre; }
                                <span class="ms-2">@nombre</span>*@
                            </a>
                        </li>
                    </ul>
                </div>
            </nav>

        }
    }
    <div class="spinner" id="spinner">
        <i class="fas fa-spinner fa-spin"></i>
    </div>
    <div class="container body-content">
        @RenderBody()
        @*<hr />
            <footer>
                <p>&copy; @DateTime.Now.Year - Mi aplicación ASP.NET</p>
            </footer>*@
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="~/Scripts/bootstrap.bundle.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/next-sidebar@1/assets/js/next-sidebar.min.js"></script>
    <script src="~/Scripts/Fechas.js"></script>
    <script src="~/Scripts/MostrarNotificaciones.js"></script> 
    <script>
        //Cambiar ACTIVE DEL NAVBAR
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('nav ul li a').forEach(link => {
                if (link.getAttribute('href').toLowerCase() === location.pathname.toLowerCase()) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });
        })

        $(document).ready(function () {
            var idLector = @(((Usuario)Session["Usuario"]).Id);
            ContarNotificaciones(idLector)
            $("#spinner").hide(); // Ocultar el spinner al cargar la página
        })
        // Mostrar el spinner al hacer una petición AJAX
        $(document).ajaxStart(function () {
            $("#spinner").show();
        });

        // Ocultar el spinner cuando todas las peticiones AJAX se completen
        $(document).ajaxStop(function () {
            $("#spinner").hide();
        });
    </script>
    @RenderSection("scripts", required: false)
</body>
</html>

