
@{
    Layout = null;
}
<!DOCTYPE html>

<html>
<head>
    <title>Login Page</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="~/CSS/Registro.css" rel="stylesheet" />
    <link href="~/CSS/Login.css" rel="stylesheet" />
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <!-- Boxicons CSS -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

</head>
<body>

    <div class="containerLogin" id="LoginFormulario">
        <div class="image"></div>
        <div class="login-form">
            <img src="~/images/LogoAppWeb.png" />
            <form action="@Url.Action("Login", "Acceso")" method="post" class="formLogin">
                <div class="row">
                    @if (ViewData["Mensaje"] != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            Tu contraseña no es correcta. Compruébala.
                        </div>
                    }
                    <div class="row">
                        <div class="col-md-1">
                            <div class="form-floating input-icon">
                                <i class="bx bxs-envelope" id="icon"></i>
                            </div>
                        </div>
                        <div class="col-md-11">
                            <div class="form-floating input-icon" id="email-field">
                                <input type="text" class="form-control" name="Email" placeholder="Correo electrónico">
                                <label>Correo electrónico</label>
                                <span class="error email error">
                                    <i class='bx bx-error-circle error-icon'></i>
                                    <p class="error-text">Introduce tu email</p>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col-md-1">
                            <div class="form-floating input-icon">
                                <i class="fas fa-lock" id="icon"></i>
                            </div>
                        </div>
                        <div class="col-md-11">
                            <div class="form-floating input-icon" id="password-field">
                                <input type="password" class="form-control" name="Contraseña" placeholder="Contraseña">
                                <label for="Nombre">Contraseña</label>
                                <i class="bx bx-hide show-hide" id="showPassword"></i>
                                <span class="error email error">
                                    <i class='bx bx-error-circle error-icon'></i>
                                    <p class="error-text">Introduzca una contraseña</p>
                                </span>
                            </div>
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <input type="submit" class="btn-login" value="Iniciar sesión" />
                        </div>
                    </div>
                    <div class="row">
                        <div class="col">
                            <a href="#" class="btn-login" data-bs-toggle="modal" data-bs-target="#registroModal">Regístrame</a>
                        </div>
                    </div>
                </div>
            </form>
            <div class="card-footer">
                <div class="d-flex justify-content-center links">
                    ¿Tienes una Biblioteca y quieres darla de alta? <a href="#" data-bs-toggle="modal" data-bs-target="#registroBiblioModal">Dar de alta Biblioteca</a>
                </div>
            </div>
        </div>
    </div>


    @* MODAL LECTOR *@
    <div class="modal fade" id="registroModal" tabindex="-1" aria-labelledby="registroModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable custom-modal">
            <div class="modal-content">
                <div class="modal-header">
                    <h4 class="modal-title" id="registroModalLabel">Registro lector</h4>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <form action="#" name="formModal">
                        <div class="container">
                            <div class="row">
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-floating" id="nombre-field">
                                            <input type="text" class="form-control" id="Nombre" placeholder="Nombre">
                                            <label>Nombre</label>
                                            <span class="error email error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce tu nombre</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating" id="apellidos-field">
                                            <input type="text" class="form-control" id="Apellidos" placeholder="Apellidos">
                                            <label>Apellidos</label>
                                            <span class="error email error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce tus apellidos</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating" id="dni-field">
                                            <input type="text" class="form-control" id="Dni" placeholder="Dni">
                                            <label>Dni</label>
                                            <span class="error email error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce un Dni válido</p>
                                            </span>
                                        </div>
                                    </div>

                                </div>
                                <div class="row">
                                    <div class="col-md-4">
                                        <div class="form-floating" id="email-field">
                                            <input type="email" class="form-control" id="Email" placeholder="Email">
                                            <label>Email</label>
                                            <span class="error email error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Tu email debe contener el símbolo  &#64; y un dominio.</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-4">
                                        <div class="form-floating" id="tlf-field">
