<div class="card shadow mb-4">
    <div class="card-header">
        <h6>Lista de préstamos</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-12">
                <div class="form-row d-flex align-items-end">
                    <div class="btn-group" role="group" aria-label="Basic radio toggle button group">
                        <input type="radio" class="btn-check" name="btnradio" id="btnradio1" autocomplete="off" value="En espera" checked>
                        <label class="btn btn-outline-primary" for="btnradio1">En espera</label>

                        <input type="radio" class="btn-check" name="btnradio" id="btnradio2" autocomplete="off" value="Pendiente recogida">
                        <label class="btn btn-outline-primary" for="btnradio2">Pendiente recogida</label>

                        <input type="radio" class="btn-check" name="btnradio" id="btnradio3" autocomplete="off" value="Pendiente devolución">
                        <label class="btn btn-outline-primary" for="btnradio3">Pendiente devolución</label>

                        <input type="radio" class="btn-check" name="btnradio" id="btnradio4" autocomplete="off" value="Devuelto">
                        <label class="btn btn-outline-primary" for="btnradio4">Devuelto</label>
                    </div>
                </div>
            </div>
        </div>


        <hr />
        <div class="row">
            <div class="col-sm-12">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tabla" style="width:100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Estado</th>
                                <th>Título</th>
                                <th>Nombre</th>
                                <th>Apellidos</th>
                                <th>Dni</th>
                                <th>Fecha devolución</th>
                                <th>Fecha confirmada</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>

<!-- Modal Recogida -->
<div class="modal fade" id="recogidamodal" tabindex="-1" aria-labelledby="registroModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable custom-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="registroModalLabel">Recogida libro</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row" id="rowrecogida">
                        <div class="row">
                            <div class="col-md-6">
                                <label class="recogidaTextBold">Recogida del libro</label>
                                <label class="recogidaText" id="nombreLibro"></label>
                            </div>
                            <div class="col-md-6">
                                <label class="recogidaTextBold">Lector asignado</label>
                                <label class="recogidaText" id="nombreLector"></label>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-6">
                                <label class="recogidaTextBold">Fecha de entrega</label>
                                <label class="recogidaText" id="fechaEntrega"></label>
                            </div>
                            <div class="col-md-6">
                                <label class="recogidaTextBold">Fecha devolución</label>
                                <label class="recogidaText" id="fechaDevol"></label>
                            </div>
                        </div>
                        <div class="row d-flex justify-content-center align-items-center">
                            <div class="col-md-4">
                                <div class="form-floating button">
                                    <input type="submit" id="btnAsignar" class="btn-registrar" value="Asignar" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>


<!-- Modal Devolucion-->
<div class="modal fade" id="devolvermodal" tabindex="-1" aria-labelledby="registroModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable custom-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="registroModalLabel">Devolución libro</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="row">
                            <div class="col-md-12">
                                <label for="message-text" class="devolucionTextBold">Estado del libro entregado:</label>
                                <textarea class="form-control" id="txtestadolibro" disabled="disabled" style="height: 70px; min-width: 100%;"></textarea>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <label for="message-text" class="devolucionTextBold">Estado del libro recibido:</label>
                                <textarea class="form-control" id="txtestadolibrorecibido" style="height: 70px; min-width: 100%;"></textarea>
                            </div>
                        </div>
                        <div class="row d-flex justify-content-center align-items-center">
                            <div class="col-md-4">
                                <div class="form-floating button">
                                    <input type="submit" id="btnGuardar" class="btn-registrar" value="Devolver" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Modal -->
<div class="modal fade" id="detallemodal" tabindex="-1" aria-labelledby="registroModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable custom-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="registroModalLabel">Devolución libro</h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <div class="container">
                    <div class="row">
                        <div class="row">
                            <div class="col-md-12">
                                <label for="message-text" class="devolucionTextBold">Estado del libro entregado:</label>
                                <textarea class="form-control" id="txtviewestadolibroentregado" disabled="disabled" style="height: 70px; min-width: 100%;"></textarea>
                            </div>
                        </div>
                        <div class="row mt-3">
                            <div class="col-md-12">
                                <label for="message-text" class="devolucionTextBold">Estado del libro recibido:</label>
                                <textarea class="form-control" id="txtviewestadolibrorecibido" disabled="disabled" style="height: 70px; min-width: 100%;"></textarea>
                            </div>
                        </div>
                        <div class="row d-flex justify-content-center align-items-center">
                            <div class="col-md-4">
                                <div class="form-floating button">                          
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

@* JQquery, Popper.js, Boostrap.js *@
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="~/Scripts/bootstrap.js"></script>
@* Libreria alert *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Scripts/sweetAlert.js"></script>
@* DataTable JS *@
<script src="~/Scripts//datatables.min.js" defer></script>
<script src="~/Scripts/Fechas.js"></script>

<script>
        var tabladata;

        $(document).ready(function () {

    // Llamar a la función de inicialización de la tabla al cargar la página
    inicializarTabla();

    // Añadir un event listener a cada botón de radio
    radioButtons.forEach(button => {
        button.addEventListener('change', function () {
            // Actualizar la tabla al cambiar la selección del botón de radio
            tabladata.ajax.reload(null, false); // Recargar la tabla sin cambiar la página actual
        });
    });
});


        // Obtener todos los botones de radio
        const radioButtons = document.querySelectorAll('input[name="btnradio"]');
        // Añadir un event listener a cada botón de radio
        radioButtons.forEach(button => { button.addEventListener('change', () => {
            const selectedValue = document.querySelector('input[name="btnradio"]:checked').value;
                switch (selectedValue) {
                    case 'En espera':

                        break;
                    case 'Pendiente recogida':

                        break;
                    case 'Pendiente devolución':

                        break;
                    case 'Devuelto':

                        break;
                    default:
                        break;
                }
            });
        });



    $(document).on('click', '.btn-recogida', function (event) {

            var json = $(this).data("informacion")  //JSON DEL ROW SELECTED
            $("#nombreLibro").text(json.Titulo);
        $("#nombreLector").text(json.Nombre + " " + json.Apellidos);
        $("#fechaEntrega").text(getCurrentDate());
        $("#fechaDevol").text(addDaysToCurrentDate(21));
            $("#btnAsignar").data("idprestamo", json.Id); //jQuery para asignar un atributo de datos llamado "data-informacion" a un elemento.
        $("#btnAsignar").data("idLibro", json.idLibro);
            $("#recogidamodal").modal("show");


        });

        $(document).on('click', '.btn-devolver', function (event) {
            var json = $(this).data("informacion")  //JSON DEL ROW SELECTED
            console.log(json)
            $("#txtestadolibro").val(json.EstadoEntregado);
            $("#btnGuardar").data("idprestamo", json.Id); //jQuery para asignar un atributo de datos llamado "data-informacion" a un elemento.
            $("#btnGuardar").data("idLibro", json.idLibro);

            $("#devolvermodal").modal("show");


        });

        $(document).on('click', '.btn-detalle', function (event) {
            var json = $(this).data("informacion")
            $("#txtviewestadolibroentregado").val(json.EstadoEntregado);
            $("#txtviewestadolibrorecibido").val(json.EstadoRecibido);

            $("#detallemodal").modal("show");
        });

        $("#btnGuardar").on("click", function () {
            var idLibro = $(this).data("idLibro");
            var prestamoDevuelto = {
                Id: $(this).data("idprestamo"),
                EstadoRecibido: $("#txtestadolibrorecibido").val()
            }
            jQuery.ajax({
                url: "/Biblioteca/DevolverPrestamo",
                type: "POST",
                data: prestamoDevuelto,
                success: function (data) {
                    // Asignar de manera automática el libro al lector en espera
                    registrarPendienteRecogida(idLibro).then(function () {
                        if (data.resultado) {
                            tabladata.ajax.reload();
                            $("#devolvermodal").modal("hide");
                        }
                    })
                        .catch(function (error) {
                            console.error(error);
                        });
                },

            });
        })
        $("#btnAsignar").on("click", function () {
            var oPrestamo;
            var oPrestamo = {
                Id: $(this).data("idprestamo"),
                Duracion: 21
            }
            var idLibro = $(this).data("idLibro");
            registroPrestamo(oPrestamo, idLibro);
        })

    function obtenerEstadoSeleccionado() {
        const selectedValue = document.querySelector('input[name="btnradio"]:checked').value;
        return selectedValue;
    }
        // Inicializar la tabla
    function inicializarTabla() {
        tabladata = $('#tabla').DataTable({
            columnDefs: [
                {
                    "defaultContent": "-",
                    "targets": "_all"
                }
            ],
            responsive: true,
            ajax: {
                "url": '@Url.Action("ListarPrestamosBiblio", "Biblioteca")',
                "type": "GET",
                "data": function (data) {
                    data.id =  @(((Usuario)Session["Usuario"]).Id);
                    data.estado = obtenerEstadoSeleccionado(); // Pasar el estado seleccionado como parámetro
                },
                "datatype": "json"
            },
            columns: [
                {
                    "data": "Estado", "render": function (data) {
                        if (data != "Devuelto") {
                            return '<span class="badge text-bg-danger p-2">' + data + '</span>';
                        } else {
                            return '<span class="badge text-bg-success p-2">' + data + '</span>';
                        }
                    }
                },
                { "data": "Titulo" },
                { "data": "Nombre" },
                { "data": "Apellidos" },
                { "data": "Dni" },
                {
                    "data": "FechaDevolucion", render: function (data) {
                        if (data != null) {
                            return getDate(data);
                        }
                    }
                },
                {
                    "data": "FechaDevolConfirmada", render: function (data) {
                        if (data != null) {
                            return getDate(data);
                        }
                    }
                },
                {
                    "data": "Estado", "render": function (data, type, row, meta) {
                        if (data == "Pendiente recogida") {
                            return $("<button>").addClass("btn btn-primary btn-recogida btn-sm").append(
                                $("<i>").addClass("fas fa-car")
                            ).attr({ "data-informacion": JSON.stringify(row) })[0].outerHTML;
                        }
                        if (data == "Pendiente devolución") {
                            return $("<button>").addClass("btn btn-primary btn-devolver btn-sm").append(
                                $("<i>").addClass("fas fa-undo-alt")
                            ).attr({ "data-informacion": JSON.stringify(row) })[0].outerHTML;
                        }
                        if (data == "Devuelto") {
                            return $("<button>").addClass("btn btn-info btn-detalle btn-sm").append(
                                $("<i>").addClass("far fa-eye")
                            ).attr({ "data-informacion": JSON.stringify(row) })[0].outerHTML;
                        }
                    }
                }
            ],
            language: {
                "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
            }
        });
    }

        //PENDIENTE RECOGIDA
        function registrarPendienteRecogida(idLibro) {
            return new Promise(function (resolve, reject) {
                var oNotificacion;
                $.ajax({
                    url: '/Lector/ObtenerUltimaReserva',
                    type: 'GET',
                    data: { id: idLibro },
                    success: function (data) {
                        var prestamoPendienteRecogida = data.data;
                        $.ajax({
                            url: '/Lector/RegistrarPendienteRecogida',
                            type: 'POST',
                            data: prestamoPendienteRecogida,
                            success: function (data) {
                                resolve();
                                //notificacion
                                oNotificacion = {
                                    idBiblioteca: prestamoPendienteRecogida.idBiblioteca,
                                    idLector: prestamoPendienteRecogida.idLector,
                                    idLibro: prestamoPendienteRecogida.idLibro
                                }
                                enviarNotificacion(oNotificacion);
                            },
                            error: function (error) {
                                console.log('Error al realizar el préstamo', error);
                            },
                        });
                    },
                    error: function (error) {
                        console.log("Error al obtener los datos del autor:", error);
                    },
                });
            });
    }
        //PENDIENTE PENDIENTE DEVOLUCION (RECOGIDA-DEVOL)
    function registroPrestamo(oPrestamo, idLibro) {
            $.ajax({
                url: "/Lector/ObtenerUltimoPrestamo",
                type: "GET",
                data: { id: idLibro },
                success: function (data) {
                    var prestamoAntiguo = data.data;
                    //Primer préstamo para el libro
                    if (prestamoAntiguo.EstadoRecibido == null) {
                        console.log("primer préstamo del libro")
                        oPrestamo.EstadoEntregado = "Libro en perfectas condiciones";
                        //Hay préstamos antiguos
                    } else {
                        console.log("ha habiado más préstamos!!")
                        oPrestamo.EstadoEntregado = prestamoAntiguo.EstadoRecibido;
                    }
                    $.ajax({
                        url: '/Lector/RegistrarPrestamo',
                        type: 'POST',
                        data: oPrestamo,
                        success: function (data) {
                            $("#recogidamodal").modal("hide");
                            tabladata.ajax.reload();
                            //Eliminar notificacion
                            eliminarNotificacion(oPrestamo.Id);
                        },
                        error: function (error) {
                            console.log('Error al realizar el préstamo', error);
                        },
                    });
                },
                error: function (error) {
                    console.log("Error al obtener los datos del autor:", error);
                }
            });
        }
        function enviarNotificacion(oNotificacion) {
            return new Promise(function (resolve, reject) {
                $.ajax({
                    url: '/Biblioteca/EnviarNotificacion',
                    type: 'POST',
                    data: oNotificacion,
                    success: function (data) {
                        console.log("notificacion enviada!")
                        resolve();
                    },
                    error: function (error) {
                        console.log('Error al enviar notificacion', error);
                    },
                });
            });
        }
        function eliminarNotificacion(idPrestamo) {
            $.ajax({
                url: '/Biblioteca/ObtenerIdentificadoresPrestamo',
                type: 'GET',
                data: { id: idPrestamo },
                success: function (data) {
                    var prestamo = data.data;
                    $.ajax({
                        url: '/Biblioteca/EliminarNotificacion',
                        type: 'POST',
                        data: prestamo,
                        error: function (error) {
                            console.log('Error al eliminar notificacion', error);
                        },
                    });
                }, error: function (error) {
                    console.log('Error al obtener identificadores prestamo', error);
                }

            })
        }
</script>
