<!DOCTYPE html>
@using BiblioConnect.Modelo
<html>
<head>
    <meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
    @Styles.Render("~/Content/css")
    @Scripts.Render("~/bundles/modernizr")

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
</head>
<meta http-equiv="Content-Type" content="text/html; charset=utf-8" />
<body>
    <nav class="navbar navbar-expand-lg bg-body-tertiary">
        <div class="container-fluid">
            <a class="navbar-brand" href="#">BiblioConnect</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false" aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                @* BIBLIOTECA NAVRBAR *@
                @{ Usuario oUsuario = Session["Usuario"] as Usuario;
                    String tipoUsuario = oUsuario.TipoUsuario;
                    int Id = oUsuario.Id;
                    if (tipoUsuario.Equals("biblioteca"))
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" href="/Biblioteca/Dashboard">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Biblioteca/Prestamo">Préstamos</a>
                            </li>
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                                    Recursos
                                </a>
                                <ul class="dropdown-menu">
                                    <li><a class="dropdown-item" href="/Biblioteca/Editorial">Editoriales</a></li>
                                    <li><a class="dropdown-item" href="/Biblioteca/Autores">Autores</a></li>
                                    <li><a class="dropdown-item" href="/Biblioteca/Libros">Libros</a></li>
                                </ul>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Biblioteca/Evento">Eventos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Biblioteca/Calendario">Mi Calendario</a>
                            </li>
                            @* Se le pasa el ID de la Biblioteca para el Perfil *@
                            <li class="nav-item">
                                <a class="nav-link" href="/Biblioteca/Perfil?id=@Id">Perfil</a>
                            </li>
                        </ul>
                    }
                    @* LECTOR NAVRBAR *@
                    else
                    {
                        <ul class="navbar-nav me-auto mb-2 mb-lg-0">
                            <li class="nav-item">
                                <a class="nav-link active" aria-current="page" href="/Lector/Inicio">Inicio</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Lector/CatalogoLibros">Catálogo</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Lector/CatalogoEventos">Eventos</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" href="/Lector/Reservas">Reservas</a>
                            </li>
                            <!-- notificaciones -->
                            <li class="nav-item dropdown">
                                <a class="nav-link dropdown-toggle" href="#" id="notificationsDropdown" role="button" data-toggle="dropdown"  data-bs-toggle="dropdown" aria-haspopup="true" aria-expanded="false">
                                    <i class="fas fa-bell"></i>
                                    <span id="notificationCount" class="position-absolute top-0 start-100 translate-middle badge rounded-pill bg-danger"></span>
                                </a>
                                <div class="dropdown-menu dropdown-menu-right" aria-labelledby="notificationsDropdown">
                                    <a class="dropdown-item" href="#">
                                        <div class="media">
                                            <img src="https://firebasestorage.googleapis.com/v0/b/tfgportalreservas.appspot.com/o/Fotos_Lectores%2FIv%C3%A1n.jpg?alt=media&token=747ab5ec-ab27-412e-b333-dc65762db409" class="mr-3" alt="Avatar">
                                            <div class="media-body">
                                                <h5 class="mt-0">Notificación 1</h5>
                                                <p>Descripción de la notificación 1</p>
                                                <small>Hace 5 minutos</small>
                                            </div>
                                        </div>
                                    </a>
                                    <!-- Agregar más notificaciones aquí -->
                                    <a class="dropdown-item" href="#">
                                        Ver todas las notificaciones
                                    </a>
                                </div>
                            </li>
                        </ul>
                    }
                }
                <form class="d-flex">
                    <div class="fs-5 mb-3">
                        @{ String nombre = oUsuario.Nombre; }

                        <i class="bi bi-person-circle"></i>
                        <span class="ms-2">Bienvenido, @nombre</span>
                    </div>
                </form>
            </div>
        </div>
    </nav>
    <div class="container body-content">
        @RenderBody()
        <hr />
        <footer>
            <p>&copy; @DateTime.Now.Year - Mi aplicación ASP.NET</p>
        </footer>
    </div>

    @Scripts.Render("~/bundles/jquery")
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.0/js/bootstrap.min.js"></script>
    <script>
        // Función para actualizar el número de notificaciones
        function actualizarNumeroNotificaciones(numero) {
            var countElement = document.getElementById("notificationCount");
            countElement.innerText = numero;
        }

        // Ejemplo de actualización del número de notificaciones
        var numeroNotificaciones = 2; // Aquí deberías obtener el número de notificaciones desde tu código
        actualizarNumeroNotificaciones(numeroNotificaciones);
    </script>
    @RenderSection("scripts", required: false)

</body>
</html>

