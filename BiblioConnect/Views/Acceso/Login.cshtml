        function deshabilitarFechasPosteriores() {
            var inputFecha = document.getElementById("FechaNacimiento");
            var fechaActual = new Date();
            var fechaActualISO = fechaActual.toISOString().split('T')[0];
            inputFecha.max = fechaActualISO;
        }
    </script>
