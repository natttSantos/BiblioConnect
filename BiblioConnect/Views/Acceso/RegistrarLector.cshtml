
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>Login Page</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css" integrity="sha384-mzrmE5qonljUremFsqc01SB46JvROS7bZs3IO2EmfFsd15uHvIt+Y8vEf7N7fWAU" crossorigin="anonymous">

    <link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
    <link href="~/CSS/Registro.css" rel="stylesheet" />
</head>
<body>
    <div class="containerModal">
        <h2>Registro Lector</h2>
        @if (ViewData["Mensaje"] != null)
        {
            <div class="alert alert-danger" role="alert">
                Las contraseñas no coinciden
            </div>
        }
        <div class="row">
            <div class="col-md-4">
                <input type="text" placeholder="Nombre" id="Nombre" class="form-control" required>
            </div>
            <div class="col-md-4">
                <input type="text" placeholder="Apellidos" id="Apellidos" class="form-control" required>
            </div>
            <div class="col-md-4">
                <input type="text" placeholder="Dni" id="Dni" class="form-control" required>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <input type="email" placeholder="Email" id="Email" class="form-control" required>
            </div>
            <div class="col-md-4">
                <input type="text" placeholder="Teléfono" id="Telefono" class="form-control" required>
            </div>
            <div class="col-md-4">
                <input type="text" placeholder="Calle" id="Calle" class="form-control" required>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <div class="form-group">
                    <select id="Estado" class="form-control">
                        <option value="Castello">Castello</option>
                        <option value="Valencia">Valencia</option>
                        <option value="Alacant">Alacant</option>
                    </select>
                </div>
            </div>
            <div class="col-md-4">
                <div class="form-group">
                    <select id="Ciudad" class="form-control"></select>
                </div>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <input type="text" placeholder="Código Postal" id="CodPostal" class="form-control" required>
            </div>
            <div class="col-md-4">
                <input type="date" placeholder="Fecha de Nacimiento" id="FechaNacimiento" class="form-control" required>
            </div>
        </div>
        <div class="row">
            <div class="col-md-4">
                <input type="password" placeholder="Contraseña" id="Contraseña" class="form-control" required>
            </div>
            <div class="col-md-4">
                <input type="password" placeholder="Confirmar contraseña" id="confirmarContraseña" class="form-control" required>
            </div>

        </div>
        <div class="row">
            <div class="col-md-8">
                <div class="form-group">
                    <img id="imglibro" height="100" width="100" class="border border-dark" />
                </div>
                <div class="form-group">
                    <input class="form-control-file" type="file" id="filelibro" onchange="readURL(this);">
                </div>
            </div>
            <div class="col-md-8">
                <button type="button" class="btn btn-primary" onclick="Guardar()">Registrar</button>
            </div>
        </div>

        <script src="~/Scripts/jquery-3.7.0.min.js"></script>
        <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>

</body>
</html>
@* Carga Script js API Paises*@
<script src="~/Scripts/API_paises.js"></script>
<script>
        var tabladata;

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#imglibro')
                        .attr('src', e.target.result)
                        .width(190)
                        .height(192);
                };

                reader.readAsDataURL(input.files[0]);
            }
        }

        function Guardar() {

            var ImagenSeleccionada = ($("#filelibro"))[0].files[0];

            var objeto = {
                Nombre: $("#Nombre").val(),
                Email: $("#Email").val(),
                Calle: $("#Calle").val(),
                Ciudad: $("#Ciudad").find("option:selected").text(),
                CodPostal: $("#CodPostal").val(),
                Apellidos: $("#Apellidos").val(),
                Dni: $("#Dni").val(),
                Telefono: $("#Telefono").val(),
                Contraseña: $("#Contraseña").val(),
                Estado: $("#Estado").find("option:selected").text(),
                Pais: $("#Pais").find("option:selected").text(),
                FechaNacimiento: $("#FechaNacimiento").val(), 
            }

            var request = new FormData();
            request.append("imagenArchivo", ImagenSeleccionada);
            request.append("objeto", JSON.stringify(objeto));

            jQuery.ajax({
                url: '@Url.Action("RegistrarLector", "Acceso")',
                type: "POST",
                data: request,
                processData: false,
                contentType : false,
                success: function (data) {
                    console.log("con éxito")
                    if (data.resultado) {
                       window.location.href = '@Url.Action("Login", "Acceso")';
                    } else {
                        alert("No se pudo guardar los cambios")
                    }
                },
                error: function (error) {
                    console.log(error)
                },
                beforeSend: function () {

                },
            });

    }
    //API DE PAISES
    $(document).ready(function () {
        $.ajax({
            url: "https://www.universal-tutorial.com/api/getaccesstoken",
            type: "GET",
            headers: {
                "Accept": "application/json",
                "api-token": "4TtTboEhH8Qb-Xx3QHOeacz4RiEenMI7rqHDdjZt4oeosXPWeEsARjPVDgI5p1iaTys",
                "user-email": "nsantosbalterra@gmail.com"
            },
            success: function (response) {
                var selectedState;
                var auth_token = response.auth_token;

                $("#Estado").change(function () {
                    selectedState = $(this).find("option:selected").text();
                    getCities(auth_token, selectedState);
                });
            },
            error: function (error) {
                console.log("Error al obtener el access token:", error);
            }
        });
    });
    function validateForm() {
        var form = document.getElementById("myForm");
        var inputs = form.querySelectorAll("input, textarea, select");
        var valid = true;

        inputs.forEach(function (input) {
            if (!input.checkValidity()) {
                input.classList.add("invalid");
                valid = false;
            } else {
                input.classList.remove("invalid");
            }
        });

        return valid;
    }

</script>

