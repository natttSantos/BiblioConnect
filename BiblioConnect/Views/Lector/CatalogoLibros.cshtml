    <body>
        <div class="container">
            <div class="row">
                <div class="col-md-2">
                    <div id="sideMenuIcon" class="fas fa-angle-double-right"></div>

                    <div class="side-bar">
                        <h1 class="heading">Filtros</h1>
                        <div class="box">
                            <h3 class="filterTitle">Búsqueda</h3>
                            <div class="search-box">
                                <input type="text" placeholder="Título, Autor, ISBN, Editorial" id="searchInput" class="form-control">
                                <span class="search-icon" onclick="Search()"><i class="fas fa-search"></i></span>
                            </div>
                        </div>
                        <div class="box">
                            <h6 class="filterTitle">CATEGORÍAS</h6>
                            <ul id="categorias-list" class="filtros-list"></ul>
                        </div>
                        <div class="box">
                            <h6 class="filterTitle">Idioma</h6>
                            <div class="type">
                                <ul id="idiomas-list" class="filtros-list">
                                    <li class="listIdiomas">Castellano</li>
                                    <li class="listIdiomas">Inglés</li>
                                    <li class="listIdiomas">Catalán</li>
                                </ul>
                            </div>
                        </div>
                        <div class="reset-btn">
                            <div class="btn" onclick="resetFilters()">Eliminar filtros</div>
                        </div>
                    </div>

                </div>
                <div class="col-md-10">
                    <h4>Libros</h4>
                    <p id="numeroItems"></p>
                    <p id="sin-items"></p>
                    <div id="libros-list" class="row"></div>
                </div>
            </div>
        </div>
    </body>


    @* JQquery, Popper.js, Boostrap.js *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    @* DataTable JS *@
    <script src="~/Scripts//datatables.min.js"></script>
    @* MAPAS *@
    <script src="~/Scripts/API_mapa.js"></script>


    <script>
    $(document).ready(function () {
        ListarAllLibros();

        $.ajax({
          url: '@Url.Action("ListarCategoria", "Biblioteca")',
          dataType: "json",
          success: function (data) {
            $.each(data.data, function (index, categoria) {
              var listItem = $("<li></li>");
              var nombre = $("<div></div>").addClass("Nombre").text(categoria.Nombre);

              listItem.append(nombre);

              $("#categorias-list").append(listItem);
            });

            // Llamar a la función para enlazar el evento click después de agregar los elementos
            bindCategoriaClick();
          },
          error: function () {
            console.log("Error al obtener las categorias");
          }
        });

        //SIDEBAR
        var sideBar = document.querySelector('.side-bar');
        var sideMenuIcon = document.getElementById('sideMenuIcon');

        sideMenuIcon.addEventListener('click', function () {
            sideBar.classList.toggle('active');
            sideMenuIcon.classList.toggle('fa-angle-double-right');
            sideMenuIcon.classList.toggle('fa-angle-double-left');
        });

        //Seleccionar un Idioma
        $(".listIdiomas").on("click", function () {
            $("#idiomas-list li").removeClass("selected");
            $(this).addClass("selected");

            var idiomaSeleccionado = $(this).text();
            var categoriaSeleccionada = $("#categorias-list li.selected .Nombre").text();
            ListarLibroPorIdiomaCategoria(idiomaSeleccionado, categoriaSeleccionada);
        });
        //Seleccionar una Categoria
        function bindCategoriaClick() {
            $("#categorias-list li").click(function () {
                $("#categorias-list li").removeClass("selected");
                $(this).addClass("selected");

                var categoriaSeleccionada = $(this).find('.Nombre').text();
                var idiomaSeleccionado = $("#idiomas-list li.selected").text();
                ListarLibroPorIdiomaCategoria(idiomaSeleccionado, categoriaSeleccionada);
            });
        }

    });
        function resetFilters() {
            document.getElementById('searchInput').value = '';
            var categoriaItems = document.querySelectorAll('#categorias-list li');
            categoriaItems.forEach(function (item) {
                item.classList.remove('selected');
            });
            var idiomaItems = document.querySelectorAll('#idiomas-list li');
            idiomaItems.forEach(function (item) {
                item.classList.remove('selected');
            });
            ListarAllLibros();
        }

        //REFACTORIZACIÓN FILTROS
        function ObtenerLibros(url, params) {
            $.ajax({
                url: url,
                type: "GET",
                data: params,
                success: function (data) {
                    var libros = data.data
                    var totalLibros = libros.length;

                    $("#libros-list").empty();
                    $.each(libros, function (index, libro) {
                        mostrarInfoLibros(libro);
                    });
                    comprobarSiHayLibros(libros); 
                    $("#numeroItems").text("1-"+ totalLibros + " de " + totalLibros + " resultados");
                },
                error: function (error) {
                    console.log("Error al obtener los libros:", error);
                }
            });
        }
        function ListarLibroPorIdiomaCategoria(idiomaSeleccionado, categoriaSeleccionada) {
            ObtenerLibros("/Lector/ListarLibroPorIdiomaCategoria", { idioma: idiomaSeleccionado, categoria: categoriaSeleccionada});
        }
        function ListarAllLibros() {
            ObtenerLibros("/Biblioteca/ListarLibro", { });
        }
        function Search() {
            var searchInput = document.getElementById('searchInput').value;
            $.ajax({
                url: "/Lector/ListarLibroPorFiltrado",
                type: "GET",
                data: { nombre: searchInput },
                success: function (data) {
                    var libros = data.data; 
                    $("#libros-list").empty(); // Eliminar contenido previo
                    $.each(libros, function (index, idLibro) {
                        $.ajax({
                            url: "/Lector/ObtenerLibro",
                            type: "GET",
                            data: { id: idLibro },
                            success: function (data) {
                                var libro = data.data;
                                libro.Id = idLibro;
                                mostrarInfoLibros(libro);
                            },
                            error: function (error) {
                                console.log("Error al realizar el filtrado", error);
                            }
                        });
                    });
                    comprobarSiHayLibros(libros); 
                },
                error: function (error) {
                    console.log("Error al realizar el filtrado", error);
                }
            });
        }
        function comprobarSiHayLibros(libros) {
            var totalLibros = libros.length; 
            if (totalLibros === 0) { // No hay libros por los filtros
                $("#sin-items").text("No hay resultados para los filtros aplicados :(");
            } else {
                $("#sin-items").text("");
            }
        }
    function mostrarInfoLibros(libro) {
      var divCard = $("<div></div>").addClass("card");
      var listItem = $("<li></li>").addClass("listCategorias");
      var link = $("<a></a>").attr("href", '@Url.Action("DetallesLibro", "Lector")?id=' + libro.Id);
      var image = $("<img>").attr("src", libro.Foto);
      var title = $("<div></div>").addClass("title").text(libro.Titulo);
      var distanceElement = $("<div></div>").addClass("distancia");

        getCiudadBiblioteca(libro.idBiblioteca)
        .then(function (provincia) {         
          distanceElement.html('<i class="fas fa-map-marker-alt"></i> ' + provincia); 
        })
        .catch(function (error) {
          console.log("Error al obtener la distancia:", error);
          distanceElement.text("Error al obtener la distancia");
        });

      link.append(image);
      divCard.append(listItem);
      divCard.append(link);
      divCard.append(title);
      divCard.append(distanceElement);

      $("#libros-list").append(divCard);
}
        function getCiudadBiblioteca(idBiblioteca) {
            console.log(idBiblioteca)
            return new Promise(function (resolve, reject) {
                $.ajax({
                    url: "/Lector/ObtenerBiblio",
                    type: "GET",
                    data: { id: idBiblioteca },
                    success: function (data) {
                        var biblio = data.data;
                        console.log("entrra")
                        resolve(biblio.Ciudad)                  
                    },
                    error: function (error) {
                        console.log("Error al obtener los datos de la Biblioteca:", error);
                        reject(error);
                    }
                });
            });
        }

