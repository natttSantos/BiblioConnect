
@{ ViewBag.Title = "Eventos";
    Layout = "~/Views/Shared/_Layout.cshtml"; }


<head>
    <head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
        @* Boostrap CSS *@
        <link href="~/Content/bootstrap.min.css" rel="stylesheet">
        @* DataTables CSS BÁSICO *@
        <link href="~/Content/datatables.min.css" rel="stylesheet" />
        @* DataTables estilo Boostrap 5 CSS *@
        <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
        @* CSS DE MAPAS *@
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        <link rel="stylesheet" type="text/css" href="~/CSS/CatalogoEventos.css" />
    </head>

    <body>
        <div class="row">
            <div class="col-md-3">
                <section>
                    @*<div>
                            <h4>Filtros:</h4>
                            <h6>Categoría:</h6>
                            <ul id="categorias-list" class="category-list"></ul>
                        </div>*@
                    <div>
                        <h6>Tipo de evento:</h6>
                        <ul id="evento-list" class="evento-list">
                            <li class="listTipoEvento">Conferencia</li>
                            <li class="listTipoEvento">Presentación libro</li>
                            <li class="listTipoEvento">Club de lectura</li>
                            <li class="listTipoEvento">Taller escritura</li>
                            <li class="listTipoEvento">Firma de libro</li>
                        </ul>
                    </div>
                </section>
            </div>
            <div class="col-md-9">
                <form class="d-flex" role="search">
                    <input id="searchInput" class="form-control me-2 custom-input" type="search" placeholder="Título, Autor" aria-label="Search">
                    <button id="searchButton" class="btn btn-outline-success" type="button" onClick="Search()">Search</button>
                </form>

                <section>
                    <ol id="eventos-list" class="card-list"></ol>
                </section>
            </div>
        </div>
    </body>


    @* JQquery, Popper.js, Boostrap.js *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    @* DataTable JS *@
    <script src="~/Scripts//datatables.min.js"></script>
    <script src="~/Scripts/API_mapa.js"></script>
    <script src="~/Scripts/Fechas.js"></script>



    <script>
    $(document).ready(function () {
        $.ajax({
            url: '@Url.Action("ListarEvento", "Lector")',
            dataType: "json",
            success: function (data) {
                $.each(data.data, function (index, evento) {
                    mostrarInfoEventos(evento);
                });
            },
            error: function () {
                console.log("Error al obtener los libros.");
            }
        });

    });

       function mostrarInfoEventos(evento) {
           getBiblioteca(evento.idBiblioteca).then(function (biblioteca) {
               return getDistance(biblioteca).then(function (distance) {
                var listItemContent =
                    '<div class="card mb-3" style="max-width: 900px;">' +
                    '<div class="row g-0">' +
                    '<div class="col-md-4">' +
                    '<img src="' + evento.Foto + '" class="img-fluid rounded-start" alt="...">' +
                    '</div>' +
                    '<div class="col-md-8">' +
                    '<div class="card-body">' +
                    '<h4 class="card-title">' + evento.Tipo + ' en la ' + biblioteca.Nombre + '</h4>' +
                    '<h5 class="card-title">' + evento.NombreAutor + '</h5>' +
                    '<h6 class="card-title">' + formatDateToReadable(evento.FechaRealizacion) + '</h6>' +
                    '<h6 class="card-title">' + evento.HoraInicio+ '-'+evento.HoraFin+ '</h6>' +
                    '<p class="card-text">' + evento.DescripcionEvento + '</p>' +
                    '<p class="card-text"><small class="text-body-secondary">' + distance.toFixed(2) + ' kilómetros</small></p>' +
                    '</div>' +
                    '</div>' +
                    '</div>' +
                    '</div>';

                //Navigate asociado al CARD
                var link = $("<a></a>").attr("href", '@Url.Action("DetallesEvento", "Lector")' + '?id=' + evento.Id);
                var listItem = $("<li></li>").append(link).append(listItemContent);
                listItem.click(function() {
                    window.location.href = link.attr("href");
                });

                $("#eventos-list").append(listItem);
               });
           });
        }
        function getDistance(biblio) {
            return new Promise(function (resolve, reject) {
            //Coordinates Biblioteca
            getLatLong(biblio.Calle, biblio.Ciudad, biblio.Estado, biblio.Pais, biblio.CodPostal)
                .then(function (coordinatesLibro) {
                    const lat1 = coordinatesLibro[0];
                    const lon1 = coordinatesLibro[1];
                    //Coordinates User
                    return getUserCurrentPosition()
                        .then(function (coordinatesUser) {
                            const lat2 = coordinatesUser[0];
                            const lon2 = coordinatesUser[1];
                            const distance = calculateDistance(lat1, lon1, lat2, lon2);
                            resolve(distance);
                        });
                })
                .catch(function (error) {
                    reject(error);
                });
             });
        }
        function getBiblioteca(idBiblioteca) {
            return new Promise((resolve, reject) => {
                $.ajax({
                    url: "/Lector/ObtenerBiblio",
                    type: "GET",
                    data: { id: idBiblioteca },
                    success: function (data) {
                        var biblioteca = data.data;
                        resolve(biblioteca);
                    },
                    error: function (error) {
                        console.log("Error al obtener los datos de la Biblioteca:", error);
                    }
                });
             });
        }
    </script>

