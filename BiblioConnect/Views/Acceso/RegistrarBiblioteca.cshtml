
@{
    Layout = null;
}

<!DOCTYPE html>

<html>
<head>
    <title>Login Page</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.1.3/css/bootstrap.min.css" integrity="sha384-MCw98/SFnGE8fJT3GXwEOngsV7Zt27NXFoaoApmYm81iuXoPkFOJwJ8ERdknLPMO" crossorigin="anonymous">
    <link rel="stylesheet" href="https://use.fontawesome.com/releases/v5.3.1/css/all.css" integrity="sha384-mzrmE5qonljUremFsqc01SB46JvROS7bZs3IO2EmfFsd15uHvIt+Y8vEf7N7fWAU" crossorigin="anonymous">

    <link rel="stylesheet" type="text/css" href="styles.css">
    <link href="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/css/bootstrap.min.css" rel="stylesheet" id="bootstrap-css">
    <link href="~/CSS/Registro.css" rel="stylesheet" />
</head>
<body>
    <div class="card">
        <h2>Registro Bibliotecas</h2>
            @if (ViewData["Mensaje"] != null)
            {
                <div class="alert alert-danger" role="alert">
                    Las contraseñas no coinciden
                </div>
            }

            <input type="text" placeholder="Nombre" id="Nombre" required>
            <input type="email" placeholder="Email" id="Email" required>
            <input type="text" placeholder="Calle" id="Calle" required>
            <input type="text" placeholder="Ciudad" id="Ciudad" required>
            <input type="text" placeholder="Código Postal" id="CodPostal" required>
            <input type="text" placeholder="Descipción" id="Descripcion" required>
            <input type="text" placeholder="Teléfono" id="Telefono" required>
            <input type="password" placeholder="Contraseña" id="Contraseña" required>
            <input type="password" placeholder="Confirmar contraseña" id="confirmarContraseña" required>
            <input type="date" placeholder="Fecha de Nacimiento" id="FechaNacimiento" required>
            <div class="col-sm-6">
                <div class="form-group">
                    <img id="imglibro" height="100" width="100" class="border border-dark" />
                </div>
                <div class="form-group">
                    <input class="form-control-file" type="file" id="filelibro" onchange="readURL(this);">
                </div>
            </div>
            <button type="button" class="btn btn-primary" onclick="Guardar()">Registrar</button>
    </div>

    <script src="//maxcdn.bootstrapcdn.com/bootstrap/4.1.1/js/bootstrap.min.js"></script>
    <script src="//cdnjs.cloudflare.com/ajax/libs/jquery/3.2.1/jquery.min.js"></script>
</body>
</html>

<script>
        var tabladata;

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#imglibro')
                        .attr('src', e.target.result)
                        .width(190)
                        .height(192);
                };

                reader.readAsDataURL(input.files[0]);
            }
        }

        function Guardar() {

            var ImagenSeleccionada = ($("#filelibro"))[0].files[0];

            var objeto = {
/*                Id: $("#txtid").val(),*/
                Nombre: $("#Nombre").val(),
                Email: $("#Email").val(),
                Calle: $("#Calle").val(),
                Ciudad: $("#Ciudad").val(),
                CodPostal: $("#CodPostal").val(),
                Descripcion: $("#Descripcion").val(),
                Telefono: $("#Telefono").val(),
                Contraseña: $("#Contraseña").val(),
            }

            var request = new FormData();
            request.append("imagenArchivo", ImagenSeleccionada);
            request.append("objeto", JSON.stringify(objeto));

            jQuery.ajax({
                url: '@Url.Action("RegistrarBiblioteca", "Acceso")',
                type: "POST",
                data: request,
                processData: false,
                contentType : false,
                success: function (data) {
                    console.log("con éxito")
                    if (data.resultado) {
                       window.location.href = '@Url.Action("Login", "Acceso")';
                    } else {
                        alert("No se pudo guardar los cambios")
                    }
                },
                error: function (error) {
                    console.log(error)
                },
                beforeSend: function () {

                },
            });

        }

</script>

