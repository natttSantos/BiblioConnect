
@{
    ViewBag.Title = "Detalles Libro";
}
@using BiblioConnect.Modelo


<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    @* DataTables CSS BÁSICO *@
    <link href="~/Content/datatables.min.css" rel="stylesheet" />
    @* DataTables estilo Boostrap 5 CSS *@
    <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    @* CSS DE MAPAS *@
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" type="text/css" href="~/CSS/DetallesLibro.css" />
</head>

<body>
    <div id="libroContainer">
        <img id="Foto" src="#" alt="Imagen">
        <div id="TituloDescripcionContainer">
            <h3 id="Titulo"></h3>
            <div id="Descripcion"></div>
        </div>
        <div class="card" style="width: 18rem;">
            <div class="card-body">
                <h6 id="Biblioteca"></h6>
                <p class="card-text">Disponible para préstamo. ¡Llévalo contigo!</p>
                <a href="#" class="card-link" id="btnPrestamo">Préstamo</a>
            </div>
        </div>
    </div>
    <div id="InformacionAdicional">
        <h6 id="Autor">Autor</h6>
        <h6 id="Categoria">Categoría</h6>
        <h6 id="Editorial">Editorial</h6>
    </div>
    <button id="btnBiblioteca">Ir a la biblioteca</button>

    @* JQquery, Popper.js, Boostrap.js *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    @* DataTable JS *@
    <script src="~/Scripts//datatables.min.js"></script>
    @* Jquery *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    @* JS DE MAPAS *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
    <script src="~/Scripts/Fechas.js"></script>
    
    <script>
        $(document).ready(function () {
            $.ajax({
                url: "/Lector/ObtenerLibro",
                type: "GET",
                data: { id: @Model },
                success: function (data) {
                    var libro = data.data;
                    $("#Foto").attr("src", libro.Foto);
                    $("#Titulo").text(libro.Titulo);
                    getBiblioteca(libro.idBiblioteca),
                    getAutor(libro.idAutor);
                    getCategoria(libro.idCategoria);
                    getEditorial(libro.idEditorial);
                    getDescription(libro.Titulo);

                },
                error: function (error) {
                    console.log("Error al obtener los datos del libro:", error);
                }
            });

            //Navigate to Perfil Biblioteca
            $("#btnBiblioteca").on("click", function () {
                var idBiblioteca = $(this).attr("data-idbiblioteca");
                if (idBiblioteca) {
                    window.location.href = "/Biblioteca/Perfil?id=" + idBiblioteca;
                }
            });
            //Realizar Préstamo
            $("#btnPrestamo").on("click", function () {
                var duracion = 21;
                var idLector = @(((Usuario)Session["Usuario"]).Id);
                 var objeto = {
                    Tipo: "prestamo",
                    IdBiblioteca: $(this).attr("data-idbiblioteca"),
                    IdLector: idLector,
                    IdLibro: @Model,
                    Descripcion: "Libro en perfectas condiciones",
                    Duracion: duracion,
                    Estado: 1,
                  };

                $.ajax({
                    url: "/Lector/RegistrarPrestamo",
                    type: "POST",
                    data: objeto,
                    success: function (data) {
                        //ALERTA DE CONFIRMACIÓN
                    },
                    error: function (error) {
                        console.log("Error al realizar el préstamo", error);
                    }
                });
            });
        });

        function getAutor(idAutor) {
            $.ajax({
                url: "/Lector/ObtenerAutor",
                type: "GET",
                data: { id: idAutor },
                success: function (data) {
                    var autor = data.data;
                    $("#Autor").text("Autor: " + autor.Nombre);
                },
                error: function (error) {
                    console.log("Error al obtener los datos del autor:", error);
                }
            });
        }
        function getCategoria(idCategoria) {
            $.ajax({
                url: "/Lector/ObtenerCategoria",
                type: "GET",
                data: { id: idCategoria },
                success: function (data) {
                    var categoria = data.data;
                    $("#Categoria").text("Categoría: "+categoria.Nombre);
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Categoria:", error);
                }
            });
        }
        function getEditorial(idEditorial) {
            $.ajax({
                url: "/Lector/ObtenerEditorial",
                type: "GET",
                data: { id: idEditorial },
                success: function (data) {
                    var editorial = data.data;
                    $("#Editorial").text("Editorial: " + editorial.Nombre);
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Editorial:", error);
                }
            });
        }
        function getBiblioteca(idBiblioteca) {
            $.ajax({
                url: "/Lector/ObtenerBiblio",
                type: "GET",
                data: { id: idBiblioteca },
                success: function (data) {
                    var biblioteca = data.data;
                    $("#Biblioteca").text(biblioteca.Nombre);
                    $("#btnBiblioteca").attr("data-idbiblioteca", idBiblioteca);
                    $("#btnPrestamo").attr("data-idbiblioteca", idBiblioteca);
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Biblioteca:", error);
                }
            });
        }

        function getDescription(title) {
        $.ajax({
            url: "https://www.googleapis.com/books/v1/volumes",
            data: { q: "intitle:" + title },
            dataType: "json",
            success: function (data) {
                if (data.items && data.items.length > 0) {
                    var book = data.items[0];
                    var summary = book.searchInfo.textSnippet;
                    $("#Descripcion").text(summary);
                } else {
                    $("#Descripcion").text("No se encontró ningún resumen para el libro.");
                }
            },
            error: function () {
                $("#description").text("Error al obtener la descripción del libro.");
            }
        });
        }
