
@{ ViewBag.Title = "Index";
    Layout = "~/Views/Shared/_Layout.cshtml"; }
@using BiblioConnect.Modelo
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    @* DataTables CSS BÁSICO *@
    <link href="~/Content/datatables.min.css" rel="stylesheet" />
    @* DataTables estilo Boostrap 5 CSS *@
    <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link href="~/CSS/Dashboard.css" rel="stylesheet" />
</head>

<body>
    <!-- Page Heading -->
    <div class="d-sm-flex align-items-center justify-content-between mb-4">
        <h4>Dashboard</h4>
    </div>
    <!-- Content Row -->
    <div class="row">
        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-primary shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="custom-card">
                                Total Libros
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="div_libros">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-book fa-2x text-black-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-success shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="custom-card">
                                Total eventos
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="div_eventos">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-users fa-2x text-black-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Earnings (Monthly) Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-info shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="custom-cardRed">
                                Préstamos Pendientes
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="div_prestamos">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-clipboard-list fa-2x text-black-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        <!-- Pending Requests Card Example -->
        <div class="col-xl-3 col-md-6 mb-4">
            <div class="card border-left-danger shadow h-100 py-2">
                <div class="card-body">
                    <div class="row no-gutters align-items-center">
                        <div class="col mr-2">
                            <div class="custom-cardGreen">
                                Reservas registradas
                            </div>
                            <div class="h5 mb-0 font-weight-bold text-gray-800" id="div_reservas">0</div>
                        </div>
                        <div class="col-auto">
                            <i class="fas fa-list-ol fa-2x text-black-50"></i>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</body>
@* JQquery, Popper.js, Boostrap.js *@
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="~/Scripts/bootstrap.js"></script>
@* DataTable JS *@
<script src="~/Scripts//datatables.min.js"></script>

@section scripts{
    <script>

            $(document).ready(function () {

                var IdBiblioteca = @(((Usuario)Session["Usuario"]).Id);
                jQuery.ajax({
                    url: '@Url.Action("ListarLibroPorBiblio", "Biblioteca")',
                    type: "GET",
                    data: { id: IdBiblioteca },
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.data != null) {
                            $("#div_libros").text(data.data.length)
                        }
                    },
                    error: function (error) {
                        console.log(error)
                    },
                });
                  jQuery.ajax({
                    url: '@Url.Action("ListarEventoPorBiblio", "Biblioteca")',
                    type: "GET",
                    data: { id: IdBiblioteca },
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        if (data.data != null) {
                            $("#div_eventos").text(data.data.length)
                        }
                    },
                    error: function (error) {
                        console.log(error)
                    },
                  });
                jQuery.ajax({
                    url: '@Url.Action("ListarPrestamosBiblio", "Biblioteca")',
                    type: "GET",
                    data: { id: IdBiblioteca, estado: "Todos" },
                    dataType: "json",
                    contentType: "application/json; charset=utf-8",
                    success: function (data) {
                        var items = data.data;
                        var prestamosCount = 0;
                        var reservasCount = 0;

                        items.forEach(function (item) {
                            if (item.Estado !== "En espera" && item.Estado !== "Devuelto") {
                                prestamosCount++;
                            } if (item.Estado === "En espera") {
                                reservasCount++;
                            }
                        });

                        $("#div_prestamos").text(prestamosCount);
                        $("#div_reservas").text(reservasCount);
                    },
                    error: function (error) {
                        console.log(error)
                    },
                });

            })


    </script>
}