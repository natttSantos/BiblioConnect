
@{ ViewBag.Title = "Libros";
    Layout = "~/Views/Shared/_Layout.cshtml"; }

@using BiblioConnect.Modelo
<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    @* DataTables CSS BÁSICO *@
    <link href="~/Content/datatables.min.css" rel="stylesheet" type="text/css" />
    @* DataTables estilo Boostrap 5 CSS *@
    <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/CSS/Modal.css" />
    <link rel="stylesheet" type="text/css" href="~/CSS/DataTable.css" />
</head>

<div class="card shadow mb-4">
    <div class="card-header">
        <h6>Lista de libros</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-12">
                <button class="btn btn-guardar btn-sm" type="button" onclick="abrirModal(null)" data-action="guardar">
                    <i class="fas fa-plus"></i> Añadir libro
                </button>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-12">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tabla" style="width:100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Imagen</th>
                                <th>Titulo</th>
                                <th>Autor</th>
                                <th>ISBN</th>
                                <th>Editorial</th>
                                <th>Categoria</th>
                                <th>Idioma</th>
                                <th>Ejemplares</th>
                                <th>Ubicación</th>
                                <th>Estado</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>



<!-- Modal -->
<div class="modal fade" id="registroLibroModal" tabindex="-1" aria-labelledby="registroModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable custom-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="registroModalLabel"></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="#" name="formModal">
                    <div class="container">
                        <div id="registrar-lector">
                            <div class="row">
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating" id="titulo-field">
                                            <input type="text" class="form-control" id="txttitulo" placeholder="Título">
                                            <label>Título</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce un título</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating" id="autor-field">
                                            <input type="text" class="form-control" id="txtautor" placeholder="Nombre autor">
                                            <label>Nombre autor</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce el nombre de autor</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating" id="ISBN-field">
                                            <input type="number" class="form-control" id="txtISBN" placeholder="ISBN" maxlength="13">
                                            <label>ISBN</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce un ISBN de 13 dígitos</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating" id="editorial-field">
                                            <input type="text" class="form-control" id="txteditorial" placeholder="Editorial">
                                            <label>Editorial</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce una editorial</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating" id="categoria-field">
                                            <select class="form-select" id="cbocategoria" aria-label="Floating label select example">
                                                <option selected>Seleccione una opcion</option>
                                            </select>
                                            <label for="floatingSelect">Categoría</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Seleccione una categoría</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating" id="idioma-field">
                                            <select class="form-select" id="cboidioma" aria-label="Floating label select example">
                                                <option selected>Seleccione una opcion</option>
                                                <option value="1">Castellano</option>
                                                <option value="2">Inglés</option>
                                                <option value="3">Catalán</option>
                                            </select>
                                            <label for="floatingSelect">Idioma</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Seleccione un idioma</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating" id="ejemplares-field">
                                            <input type="number" class="form-control" id="txtejemplares" placeholder="Número de ejemplares">
                                            <label>Número de ejemplares</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce un número de ejemplares</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating" id="ubicacion-field">
                                            <input type="text" class="form-control" id="txtubicacion" placeholder="Ubicación">
                                            <label>Ubicación</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce una ubicación</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="imagen" id="imagen-field">
                                            <label for="filelibro" class="form-label">Seleccione una imagen:</label>
                                            <input class="form-control" type="file" id="filelibro" onchange="readURL(this, true)">
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">No ha seleccionado ninguna imagen</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <img id="imglibro" class="border border-dark img-thumbnail" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row  d-flex justify-content-center align-items-center">
                                    <div class="col-md-4">
                                        <div class="form-floating button">
                                            <input type="submit" class="btn-registrar" value="Registrar" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>


@* JQquery, Popper.js, Boostrap.js *@
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="~/Scripts/bootstrap.js"></script>
@* Libreria alert *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Scripts/sweetAlert.js"></script>
@* DataTable JS *@
<script src="~/Scripts//datatables.min.js" defer></script>
<script src="~/Validate/RegistroLibro.js"></script>

@section scripts{

    <script>
        var tabladata;
        var idLibroSelected = 0;

        function readURL(input) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    $('#imglibro')
                        .attr('src', e.target.result)
                        .width(190)
                        .height(192);
                };

                reader.readAsDataURL(input.files[0]);
            }
        }

        //CONSUMEN LA API REST CREADA PARA EL DROPDOWNLIST
        $(document).ready(function () {
            jQuery.ajax({
                url: '@Url.Action("ListarCategoria", "Biblioteca")',
                type: "GET",
                data: null,
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {
                    $.each(data.data, function (index, value) {
                        $("<option>").attr({ "value": value.Id }).text(value.Nombre).appendTo("#cbocategoria");
                    });
                },
                error: function (error) {
                    console.log(error)
                }
            });

            //LISTADO DE LIBROS
            tabladata = $('#tabla').DataTable({
                responsive: true,
                columnDefs: [{
                    "defaultContent": "-",
                    "targets": "_all"
                }],
                "ajax": {
                    "url": '@Url.Action("ListarLibroPorBiblio", "Biblioteca")',
                    "type": "GET",
                    "data": function (data) {
                             var IdBiblioteca = @(((Usuario)Session["Usuario"]).Id);
                             data.id = IdBiblioteca;
                        },
                    "datatype": "json"
                },
                "columns": [
                    {
                        "data": "Foto", render: function (data) {
                            return '<img src=' + '"' +  data + '"' + 'width="64" height="90">'
                        }
                    },
                    { "data": "Titulo" },
                    { "data": "Autor" },
                    { "data": "ISBN" },
                    { "data": "Editorial" },
                    {
                        "data": "idCategoria",
                        "render": function(data, type, row) {
                              $.ajax({
                                url: '@Url.Action("ObtenerCategoria", "Lector")',
                                type: 'GET',
                                data: { id: data },
                                dataType: 'json',
                                async: false,
                                success: function(response) {
                                  data = response.data.Nombre;
                                },
                                error: function(error) {
                                  console.log(error);
                                }
                              });
                          return data;
                        }
                    },
                    { "data": "Idioma" },
                    { "data": "numEjemplares" },
                    { "data": "Ubicacion" },
                    {
                        "data": "Estado", "render": function (data) {
                            if (data) {
                                return '<span class="badge text-bg-success p-2">Activo</span>'
                            } else {
                                return '<span class="badge text-bg-danger p-2">No Activo</span>'
                            }
                        }
                    },
                    {
                        "data": "Id",
                        "render": function (data, type, row, meta) {
                            return $("<button>")
                                .addClass("btn btn-primary btn-editar btn-sm")
                                .html('<i class="fas fa-edit"></i>') // Agrega el ícono de editar (FontAwesome)
                                .attr({
                                    "data-action": "modificar", // Agregar el atributo data-action con el valor "editar"
                                    "data-informacion": JSON.stringify(row)
                                })[0].outerHTML +
                                $("<button>")
                                    .addClass("btn btn-danger btn-eliminar btn-sm ml-2")
                                    .html('<i class="fas fa-trash"></i>') // Agrega el ícono de eliminar (FontAwesome)
                                    .attr({
                                        "data-action": "eliminar", // Agregar el atributo data-action con el valor "eliminar"
                                        "data-informacion": JSON.stringify(row)
                                    })[0].outerHTML;
                        },
                        "orderable": false,
                        "searchable": false,
                        "width": "90px"

                    }


                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                }
            });
        });

        //GUARDAR LIBRO
        $(".btn-guardar").on("click", function (event) {
            document.querySelector(".btn-guardar").dataset.action = "guardar";
        });
         //EDITAR LIBRO
        $(document).on('click', '.btn-editar', function (event) {
            var json = $(this).data("informacion")
            idLibroSelected = json.Id; //SET VARIABEL GLOBAL DEL LIBRO
            abrirModal(json)
            document.querySelector(".btn-guardar").dataset.action = "editar";
        });
        //ELIMINAR LIBRO
        $(document).on('click', '.btn-eliminar', function (event) {
            var json = $(this).data("informacion")
            alertConfirm('¿Está seguro de eliminar el libro?',
                'El libro se eliminará permanentemente').then(() => {
                    Eliminar(json.Id);
                })
        });

        function abrirModal(json) {
            vaciarFormulario();
            if (json != null) { //EDITAR DATOS
                $("#registroModalLabel").text("Editar libro"); //TÍTULO MODAL
                $("#txtid").val(json.Id);
                $("#imglibro").attr({ "src": "data:image/" + json.extension + ";base64," + json.base64 });
                $("#txttitulo").val(json.Titulo);
                $("#txtISBN").val(json.ISBN);
                $("#txtautor").val(json.Autor);
                $("#txteditorial").val(json.Editorial);
                $("#cboautor").val(json.idAutor);
                $("#cbocategoria").val(json.idCategoria);
                $("#cboidioma").val(getSelectedValue(json.Idioma));
                $("#txtubicacion").val(json.Ubicacion);
                $("#txtejemplares").val(json.numEjemplares);
            } else {
                $("#registroModalLabel").text("Registrar libro"); //TÍTULO MODAL
            }
            $('#registroLibroModal').modal('show');
        }

        //DEVUELVE EL VALUE DEL SELECT
        function getSelectedValue(selectedText) {
            const selectElement = document.getElementById('cboidioma');
            for (const option of selectElement.options) {
                if (option.text === selectedText) {
                    return option.value;
                }
            }
            return null;
        }

        function vaciarFormulario() {
            $("#txtid").val(0);
            $("#imglibro").attr({ "src": "" });
            $("#filelibro").val("");
            $("#txttitulo").val("");
            $("#txtISBN").val("");
            $("#txtautor").val("");
            $("#txteditorial").val("");
            $("#cbocategoria").val($("#cbocategoria option:first").val());
            $("#cboidioma").val($("#cboidioma option:first").val());
            $("#txtubicacion").val("");
            $("#txtejemplares").val("");
            $("#cboEstado").val(1);
        }
        function obtenerDatosFormulario() {
            var IdBiblioteca = @(((Usuario)Session["Usuario"]).Id);
            var objeto = {
                Id: idLibroSelected,
                Titulo: $("#txttitulo").val(),
                Autor: $("#txtautor").val(),
                Editorial: $("#txteditorial").val(),
                idCategoria: $("#cbocategoria option:selected").val(),
                Ubicacion: $("#txtubicacion").val(),
                numEjemplares: $("#txtejemplares").val(),
                ISBN: $("#txtISBN").val(),
                Idioma: $("#cboidioma option:selected").text(),
                idBiblioteca: IdBiblioteca,
                Estado: parseInt($("#cboEstado").val()) == 1 ? true : false,
            }

            var ImagenSeleccionada = ($("#filelibro"))[0].files[0];
            var request = new FormData();
            request.append("imagenArchivo", ImagenSeleccionada);
            request.append("objeto", JSON.stringify(objeto));
            return request;
        }

        function Eliminar(idLibro) {
            jQuery.ajax({
                url: '@Url.Action("EliminarLibro", "Biblioteca")',
                type: "POST",
                data: JSON.stringify({ id: idLibro }),
                dataType: "json",
                contentType: "application/json; charset=utf-8",
                success: function (data) {

                    if (data.resultado) {
                        tabladata.ajax.reload();
                    } else {
                        alert("No se pudo eliminar")
                    }
                },
                error: function (error) {
                    console.log(error)
                },
                beforeSend: function () {

                },
            });
        }
        function Guardar() {
            console.log("guardar")
            var request = obtenerDatosFormulario();

            jQuery.ajax({
                url: '@Url.Action("GuardarLibro", "Biblioteca")',
                type: "POST",
                data: request,
                processData: false,
                contentType : false,
                success: function (resultado) {
                    if (resultado) {
                        tabladata.ajax.reload();
                        $('#registroLibroModal').modal('hide');
                    } else {
                        alert("No se pudo guardar los cambios")
                    }
                },
                error: function (error) {
                    console.log(error)
                },
            });
        }
        function Modificar() {
           console.log("modificar")
            var request = obtenerDatosFormulario();

            jQuery.ajax({
                url: '@Url.Action("ModificarLibro", "Biblioteca")',
                type: "POST",
                data: request,
                processData: false,
                contentType : false,
                success: function (resultado) {
                    if (resultado) {
                        tabladata.ajax.reload();
                        $('#registroLibroModal').modal('hide');
                    } else {
                        alert("No se pudo modificar el libro")
                    }
                },
                error: function (error) {
                    console.log(error)
                },
            });
        }

    //REFACTORIZACIÓN
    function AccionLibro(urlAction) {
        var request = obtenerDatosFormulario();
        jQuery.ajax({
            url: urlAction,
            type: "POST",
            data: request,
            processData: false,
            contentType : false,
            success: function (resultado) {
                if (resultado) {
                    tabladata.ajax.reload();
                    $('#registroLibroModal').modal('hide');
                } else {
                    alert("No se pudo modificar el libro")
                }
            },
            error: function (error) {
                console.log(error)
            },
        });
    }

    function Guardar() {
        var guardarUrl = '@Url.Action("GuardarLibro", "Biblioteca")';
        AccionLibro(guardarUrl);
    }

    function Modificar() {
        var modificarUrl = '@Url.Action("ModificarLibro", "Biblioteca")';
        AccionLibro(modificarUrl);
    }

    </script>

}
