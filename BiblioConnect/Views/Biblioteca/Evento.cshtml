
@{ ViewBag.Title = "Evento";
    Layout = "~/Views/Shared/_Layout.cshtml"; }
@using BiblioConnect.Modelo

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- Boxicons CSS -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    @* DataTables CSS BÁSICO *@
    <link href="~/Content/datatables.min.css" rel="stylesheet" type="text/css" />
    @* DataTables estilo Boostrap 5 CSS *@
    <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <link rel="stylesheet" type="text/css" href="~/CSS/Modal.css" />
    <link rel="stylesheet" type="text/css" href="~/CSS/DataTable.css" />
</head>

<div class="card shadow mb-4">
    <div class="card-header">
        <h6>Lista de eventos</h6>
    </div>
    <div class="card-body">
        <div class="row">
            <div class="col-sm-12">
                <button class="btn btn-guardar btn-sm" type="button" onclick="abrirModal(null)" data-action="guardar">
                    <i class="fas fa-plus"></i> Añadir evento
                </button>
            </div>
        </div>
        <hr />
        <div class="row">
            <div class="col-sm-12">
                <div class="table-responsive">
                    <table class="table table-bordered" id="tabla" style="width:100%" cellspacing="0">
                        <thead>
                            <tr>
                                <th>Imagen</th>
                                <th>Autor</th>
                                <th>Tipo</th>
                                <th>Fecha realización</th>
                                <th>Hora inicio</th>
                                <th>Hora fin</th>
                                <th>Acciones</th>
                            </tr>
                        </thead>
                    </table>
                </div>
            </div>
        </div>

    </div>
</div>


<!-- Modal -->
<div class="modal fade" id="registroEventoModal" tabindex="-1" aria-labelledby="registroModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-dialog-scrollable custom-modal">
        <div class="modal-content">
            <div class="modal-header">
                <h4 class="modal-title" id="registroModalLabel"></h4>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <form action="#" name="formModal">
                    <div class="container">
                        <div id="registrar-lector">
                            <div class="row">
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-floating" id="autor-field">
                                            <input type="text" class="form-control nombreAutor" id="nombreAutor" placeholder="Nombre autor">
                                            <label>Nombre autor</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce un nombre de autor</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating" id="tipo-field">
                                            <select class="form-select" id="tipoEvento" aria-label="Floating label select example">
                                                <option selected>Seleccione una opcion</option>
                                                <option value="1">Conferencia</option>
                                                <option value="2">Presentación libro</option>
                                                <option value="3">Club de lectura</option>
                                                <option value="4">Taller escritura</option>
                                                <option value="5">Firma de libro</option>
                                            </select>
                                            <label for="floatingSelect">Tipo de evento</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Seleccione un tipo de evento</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating" id="fecha-field">
                                            <input type="date" placeholder="Fecha Evento" id="fechaRealizacion" class="form-control">
                                            <label>Fecha</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce un fecha</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="form-floating" id="horaInicio-field">
                                            <input type="time" placeholder="Hora" id="horaInicio" class="form-control">
                                            <label>Hora inicio</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce una hora de inicio</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-floating" id="horaFin-field">
                                            <input type="time" placeholder="Hora" id="horaFin" class="form-control">
                                            <label>Hora fin</label>
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce una hora fin</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-floating" id="descripcionAutor-field">
                                            <textarea class="form-control" id="descripcionAutor" placeholder="Descripcion" maxlength="500"></textarea>
                                            <label for="DescripcionBiblio">Descripcion autor</label>
                                            <span class="error email error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce una descripción de autor</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-md-12">
                                        <div class="form-floating" id="descripcionEvento-field">
                                            <textarea class="form-control" id="descripcionEvento" placeholder="Descripcion" maxlength="500"></textarea>
                                            <label for="DescripcionBiblio">Descripcion evento</label>
                                            <span class="error email error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">Introduce una descripción de evento</p>
                                            </span>
                                        </div>
                                    </div>
                                </div>

                                <div class="row">
                                    <div class="col-md-6">
                                        <div class="imagen" id="imagen-field">
                                            <label for="filelibro" class="form-label">Seleccione una imagen:</label>
                                            <input class="form-control" type="file" id="filelibro" onchange="readURL(this, true)">
                                            <span class="error type error">
                                                <i class='bx bx-error-circle error-icon'></i>
                                                <p class="error-text">No ha seleccionado ninguna imagen</p>
                                            </span>
                                        </div>
                                    </div>
                                    <div class="col-md-6">
                                        <div class="form-group">
                                            <img id="imglibro" class="border border-dark img-thumbnail" />
                                        </div>
                                    </div>
                                </div>
                                <div class="row  d-flex justify-content-center align-items-center">
                                    <div class="col-md-4">
                                        <div class="form-floating button">
                                            <input type="submit" class="btn-registrar" value="Registrar" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@* JQquery, Popper.js, Boostrap.js *@
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="~/Scripts/bootstrap.js"></script>
@* Libreria alert *@
<script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
<script src="~/Scripts/sweetAlert.js"></script>
@* DataTable JS *@
<script src="~/Scripts//datatables.min.js" defer></script>
<script src="~/Scripts/Fechas.js"></script>
<script src="~/Validate/RegistroEvento.js"></script>

<script>
    var tabladata;
    idEventoSelected = 0;

    function readURL(input) {
        if (input.files && input.files[0]) {
            var reader = new FileReader();

            reader.onload = function (e) {
                $('#imgAutor')
                    .attr('src', e.target.result)
                    .width(190)
                    .height(192);
            };

            reader.readAsDataURL(input.files[0]);
        }
    }

    $(document).ready(function () {

            //LISTADO DE LIBROS
            tabladata = $('#tabla').DataTable({
                responsive: true,
                columnDefs: [{
                    "defaultContent": "-",
                    "targets": "_all"
                }],
                "ajax": {
                    "url": '@Url.Action("ListarEventoPorBiblio", "Biblioteca")',
                    "type": "GET",
                    "data": function (data) {
                             var IdBiblioteca = @(((Usuario)Session["Usuario"]).Id);
                             data.id = IdBiblioteca;
                        },
                    "datatype": "json"
                },
                "columns": [
                    {
                        "data": "Foto", render: function (data) {
                            return '<img src=' + '"' +  data + '"' + 'width="70" height="70">'
                        }
                    },
                    { "data": "NombreAutor" },
                    { "data": "Tipo" },
                    {
                        "data": "FechaRealizacion", render: function (data) {
                            return getDate(data);
                        }
                    },
                    { "data": "HoraInicio" },
                    { "data": "HoraFin" },
                    {
                        "data": "Id",
                        "render": function (data, type, row, meta) {
                            return $("<button>")
                                .addClass("btn btn-primary btn-editar btn-sm")
                                .html('<i class="fas fa-edit"></i>')
                                .attr({
                                    "data-action": "modificar",
                                    "data-informacion": JSON.stringify(row)
                                })[0].outerHTML +
                                $("<button>")
                                    .addClass("btn btn-danger btn-eliminar btn-sm ml-2")
                                    .html('<i class="fas fa-trash"></i>')
                                    .attr({
                                        "data-action": "eliminar",
                                        "data-informacion": JSON.stringify(row)
                                    })[0].outerHTML;
                        },
                        "orderable": false,
                        "searchable": false,
                        "width": "90px"

                    }

                ],
                "language": {
                    "url": "//cdn.datatables.net/plug-ins/1.10.25/i18n/Spanish.json"
                }
            });
        });

    $(document).on('click', '.btn-editar', function (event) {
        var json = $(this).data("informacion")
        console.log(json)
        idEventoSelected = json.Id; //SET VARIABEL GLOBAL DEL EVENTO
        abrirModal(json)
        document.querySelector(".btn-guardar").dataset.action = "editar";
    });
    $(".btn-guardar").on("click", function (event) {
        document.querySelector(".btn-guardar").dataset.action = "guardar";
    });
    $(document).on('click', '.btn-eliminar', function (event) {
        var json = $(this).data("informacion")
        alertConfirm('¿Está seguro de eliminar el evento?',
            'El evento se eliminará permanentemente').then(() => {
                Eliminar(json.Id);
            })
    });

    //DEVUELVE EL VALUE DEL SELECT
    function getSelectedValue(selectedText) {
        const selectElement = document.getElementById('tipoEvento');
        for (const option of selectElement.options) {
            if (option.text === selectedText) {
                return option.value;
            }
        }
        return null;
    }

    function vaciarFormulario() {
        $("#imgAutor").attr({ "src": "" });
        $("#nombreAutor").val("");
        $("#fechaRealizacion").val("");
        $("#horaInicio").val("");
        $("#horaFin").val("");
        $("#descripcionAutor").val("");
        $("#descripcionEvento").val("");
        $("#tipoEvento").val($("#tipoEvento option:first").val());
    }

    function obtenerDatosFormulario() {
        var IdBiblioteca = @(((Usuario)Session["Usuario"]).Id);
        console.log(idEventoSelected )
        var objeto = {
            Id: idEventoSelected,
            idBiblioteca: IdBiblioteca,
            NombreAutor: $("#nombreAutor").val(),
            FechaRealizacion: $("#fechaRealizacion").val(),
            HoraInicio: $("#horaInicio").val(),
            HoraFin: $("#horaFin").val(),
            DescripcionAutor: $("#descripcionAutor").val(),
            DescripcionEvento: $("#descripcionEvento").val(),
            Tipo: $("#tipoEvento option:selected").text(),
        }
        var ImagenSeleccionada = ($("#filelibro"))[0].files[0];
        var request = new FormData();
        request.append("imagenArchivo", ImagenSeleccionada);
        request.append("objeto", JSON.stringify(objeto));
        return request;
    }

    function abrirModal(json) {
        vaciarFormulario();
        if (json != null) { //EDITAR DATOS
            $("#registroModalLabel").text("Editar evento"); //TÍTULO MODAL
            $("#imglibro").attr({ "src": "data:image/" + json.extension + ";base64," + json.base64 });
            $("#nombreAutor").val(json.NombreAutor);
            $("#fechaRealizacion").val(getDateFormatCalendar(json.FechaRealizacion));
            $("#horaInicio").val(json.HoraInicio);
            $("#horaFin").val(json.HoraFin);
            $("#descripcionAutor").val(json.DescripcionAutor);
            $("#descripcionEvento").val(json.DescripcionEvento);
            $("#tipoEvento").val(getSelectedValue(json.Tipo));
        }
        else {
            $("#registroModalLabel").text("Registrar evento"); //TÍTULO MODAL
        }
        $('#registroEventoModal').modal('show');
    }

    //REFACTORIZACIÓN
    function AccionEvento(urlAction) {
        var request = obtenerDatosFormulario();
        jQuery.ajax({
            url: urlAction,
            type: "POST",
            processData: false,
            contentType: false,
            data: request,
            success: function (resultado) {
                if (resultado) {
                    tabladata.ajax.reload();
                    $('#registroEventoModal').modal('hide');
                } else {
                    alert("No se pudo guardar los cambios");
                }
            },
            error: function (error) {
                console.log(error);
            },
        });
    }

    function Guardar() {
        console.log("guardar")
        var guardarUrl = '@Url.Action("GuardarEvento", "Biblioteca")';
        AccionEvento(guardarUrl);
    }

    function Modificar() {
        console.log("modificar")
        var modificarUrl = '@Url.Action("ModificarEvento", "Biblioteca")';
        AccionEvento(modificarUrl);
    }
    function Eliminar(EventoId){
        jQuery.ajax({
        url: '@Url.Action("EliminarEvento", "Biblioteca")',
        type: "POST",
        data: JSON.stringify({ id: EventoId}),
        dataType: "json",
        contentType: "application/json; charset=utf-8",
        success: function (data) {

            if (data.resultado) {
                tabladata.ajax.reload();
            } else {
                alert("No se pudo eliminar")
            }
        },
        error: function (error) {
            console.log(error)
        },
        });
    }

</script>
