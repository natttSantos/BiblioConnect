
@{
    ViewBag.Title = "Notificaciones";
}
@using BiblioConnect.Modelo
<head>
    <title>Login Page</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <link href="~/CSS/Notificacion.css" rel="stylesheet" />
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <!-- Boxicons CSS -->
    <link href='https://unpkg.com/boxicons@2.1.4/css/boxicons.min.css' rel='stylesheet'>

</head>

<section class="section-50">
    <div class="container">
        <h4 id="titleNotification">Notificaciones <i class="fa fa-bell"></i></h4>
        <div class="notification-ui_dd-content" id="notification-ui_dd-content"></div>
    </div>
</section>

<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="~/Scripts/bootstrap.bundle.min.js"></script>
<script src="https://cdn.jsdelivr.net/npm/next-sidebar@1/assets/js/next-sidebar.min.js"></script>
<script src="~/Scripts/Fechas.js"></script>
<script src="~/Scripts/MostrarNotificaciones.js"></script>
<script>
            $(document).ready(function () {
            var idLector = @(((Usuario)Session["Usuario"]).Id);
            ListarNotificaciones(idLector)
        })
</script>