    <script src="~/Scripts/Fechas.js"></script>
    <script src="~/Scripts/MostrarNotificaciones.js"></script>
    <script>
        //Cambiar ACTIVE DEL NAVBAR
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('nav ul li a').forEach(link => {
                if (link.getAttribute('href').toLowerCase() === location.pathname.toLowerCase()) {
                    link.classList.add('active');
                } else {
                    link.classList.remove('active');
                }
            });
        })

        $(document).ready(function () {
            var idLector = @(((Usuario)Session["Usuario"]).Id);
            ListarNotificaciones(idLector)
            $("#spinner").hide(); // Ocultar el spinner al cargar la página
        })
        // Mostrar el spinner al hacer una petición AJAX
        $(document).ajaxStart(function () {
            $("#spinner").show();
        });

        // Ocultar el spinner cuando todas las peticiones AJAX se completen
        $(document).ajaxStop(function () {
            $("#spinner").hide();
        });
    </script>
