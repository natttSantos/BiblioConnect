@{
    ViewBag.Title = "Detalles evento";
}

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    <!-- Bootstrap CSS -->
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    <!-- DataTables CSS BÁSICO -->
    <link href="~/Content/datatables.min.css" rel="stylesheet" />
    <!-- DataTables estilo Boostrap 5 CSS -->
    <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    <!-- CSS DE MAPAS -->
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" type="text/css" href="~/CSS/Mapa.css" />
    <link rel="stylesheet" type="text/css" href="~/CSS/Detalles.css" />
</head>

<body>
    <div class="container">
        <div class="row">
            <div class="row">
                <div class="col-md-10">
                    <h5 class="title">Información sobre el evento</h5>
                    <h3 id="Tipo" class="titulo-obra"></h3>
                    <h6 id="FechaRealizacion"></h6>
                    <h6 id="Hora"></h6>
                    <p id="DescripcionEvento"></p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-3">
                    <img id="FotoAutor" src="#" alt="Imagen">
                </div>
                <div class="col-md-7">
                    <h5 class="title">Información sobre el autor</h5>
                    <h6 id="NombreAutor" class="autor"></h6>
                    <p id="DescripcionAutor"></p>
                </div>
            </div>
            <div class="row">
                <div class="col-md-10">
                    <h5 class="title">Ubicación</h5>
                    <h6 id="Biblioteca"></h6>
                    <div id="map"></div>
                </div>
            </div>
        </div>
    </div>
</body>

<!-- JQquery, Popper.js, Boostrap.js -->
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="~/Scripts/bootstrap.js"></script>
<!-- DataTable JS -->
<script src="~/Scripts/datatables.min.js"></script>
<!-- JS DE MAPAS -->
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="~/Scripts/API_mapa.js"></script>
<script src="~/Scripts/Fechas.js"></script>
<script>
    $(document).ready(function () {
        var IdBiblioteca;

        $.ajax({
            url: "/Lector/ObtenerEvento",
            type: "GET",
            data: { id: @Model },
            success: function (data) {
                var evento = data.data;
                IdBiblioteca = evento.idBiblioteca;
                mostrarInfoEventos(evento);
            },
            error: function (error) {
                console.log("Error al obtener los datos del libro:", error);
            }
        });

        function mostrarInformacion(evento) {
            $("#FotoAutor").attr("src", evento.Foto);
            $("#NombreAutor").text(evento.NombreAutor);
            $("#Tipo").text(evento.Tipo);
            $("#Hora").text(evento.HoraInicio + "-" + evento.HoraFin);
            $("#FechaRealizacion").html('<i class="far fa-calendar-alt date"></i> ' + formatDateToReadable(evento.FechaRealizacion));
            $("#DescripcionAutor").text(evento.DescripcionAutor);
            $("#DescripcionEvento").text(evento.DescripcionEvento);
        }
        async function getBiblioteca(idBiblioteca) {
            try {
                const data = await $.ajax({
                    url: "/Lector/ObtenerBiblio",
                    type: "GET",
                    data: { id: idBiblioteca },
                });
                return data.data;
            } catch (error) {
                console.log("Error al obtener los datos de la Biblioteca:", error);
                throw error;
            }
        }

        async function mostrarInfoEventos(evento) {
            try {
                const biblio = await getBiblioteca(evento.idBiblioteca);
                const coordinatesLibro = await getLatLong(biblio.Calle, biblio.Ciudad, biblio.Estado, biblio.Pais, biblio.CodPostal);
                const lat = coordinatesLibro[0];
                const lon = coordinatesLibro[1];
                mostrarMapa(lat, lon);

                mostrarInformacion(evento);

                // Crear el enlace con el icono de biblioteca
                const bibliotecaContainer = $("#Biblioteca");
                const bibliotecaIcon = $("<i>").addClass("fas fa-book icono-biblioteca");
                const bibliotecaLink = $("<a>")
                    .attr("href", "/Biblioteca/Perfil?id=" + IdBiblioteca)
                    .text(biblio.Nombre)
                    .prepend(bibliotecaIcon);
                bibliotecaContainer.empty().append(bibliotecaLink);
            } catch (error) {
                console.log("Error:", error);
            }
        }
    });
</script>
