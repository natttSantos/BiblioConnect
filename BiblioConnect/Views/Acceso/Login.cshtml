    @* Carga Script js API Paises*@
    <script src="~/Scripts/API_paises.js"></script>
    <script>
        var tabladata;

        function readURL(input, esBiblio) {
            if (input.files && input.files[0]) {
                var reader = new FileReader();

                reader.onload = function (e) {
                    if (!esBiblio) {
                        $('#imglector')
                            .attr('src', e.target.result)
                            .width(190)
                            .height(192);
                    } else {
                        $('#imglectorBiblio')
                            .attr('src', e.target.result)
                            .width(190)
                            .height(192);
                    }

                };

                reader.readAsDataURL(input.files[0]);
            }
        }

        function GuardarLector() {
            var ImagenSeleccionada = ($("#filelibro"))[0].files[0];
            var objeto = {
                Nombre: $("#Nombre").val(),
                Email: $("#Email").val(),
                Calle: $("#Calle").val(),
                Ciudad: $("#Ciudad").find("option:selected").text(),
                CodPostal: $("#CodPostal").val(),
                Apellidos: $("#Apellidos").val(),
                Dni: $("#Dni").val(),
                Telefono: $("#Telefono").val(),
                Contraseña: $("#Contraseña").val(),
                Estado: $("#Estado").find("option:selected").text(),
                Pais: $("#Pais").find("option:selected").text(),
                FechaNacimiento: $("#FechaNacimiento").val(),
            }
            var request = new FormData();
            request.append("imagenArchivo", ImagenSeleccionada);
            request.append("objeto", JSON.stringify(objeto));
            jQuery.ajax({
                url: '@Url.Action("RegistrarLector", "Acceso")',
                type: "POST",
                data: request,
                processData: false,
                contentType : false,
                success: function (data) {
                    if (data.resultado) {
                        alertSuccess('¡Enhorabuena!', 'Acabas de registrarte como lector').then(() => {
                            $('#registroModal').modal('hide');
                        })
                    } else {
                        alert("No se pudo guardar los cambios")
                    }
                },
                error: function (error) {
                    console.log(error)
                }
            });
    }
            function GuardarBiblioteca() {
                var ImagenSeleccionada = ($("#filelibroBiblio"))[0].files[0];

            var objeto = {
                Nombre: $("#NombreBiblio").val(),
                Email: $("#EmailBiblio").val(),
                Calle: $("#CalleBiblio").val(),
                Ciudad: $("#CiudadBiblio").find("option:selected").text(),
                CodPostal: $("#CodPostalBiblio").val(),
                Descripcion: $("#DescripcionBiblio").val(),
                Telefono: $("#TelefonoBiblio").val(),
                Contraseña: $("#ContraseñaBiblio").val(),
                Estado: $("#EstadoBiblio").find("option:selected").text(),
                Pais: $("#PaisBiblio").find("option:selected").text(),
            }

            var request = new FormData();
            request.append("imagenArchivo", ImagenSeleccionada);
            request.append("objeto", JSON.stringify(objeto));

            jQuery.ajax({
                url: '@Url.Action("RegistrarBiblioteca", "Acceso")',
                type: "POST",
                data: request,
                processData: false,
                contentType : false,
                success: function (data) {
                    if (data.resultado) {
                        alertSuccess('¡Enhorabuena!', 'Acabas de registrar una biblioteca').then(() => {
                            $('#registroBiblioModal').modal('hide');
                        })
                    } else {
                        alert("No se pudo guardar los cambios")
                    }
                },
                error: function (error) {
                    console.log(error)
                }
            });
    }
