
@{
    ViewBag.Title = "Perfil";
}
@using BiblioConnect.Modelo
@model Biblioteca

<head>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    @* DataTables CSS BÁSICO *@
    <link href="~/Content/datatables.min.css" rel="stylesheet" />
    @* DataTables estilo Boostrap 5 CSS *@
    <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    @* CSS DE MAPAS *@
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css"
          integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY="
          crossorigin="" />
    <link rel="stylesheet" type="text/css" href="~/CSS/Mapa.css" />
</head>
<body>
    <div style="display: flex; align-items: center;">
        <img src=@Model.Foto alt="Imagen" style="width: 300px; height: 300px; margin-right: 10px;">
        <div>
            <h5>@Model.Nombre</h5>
            <p>@Model.Descripcion</p>
        </div>
    </div>
    <br />
    <h5>Ubicación biblioteca:</h5>
    <div id="map"></div>
    <br />
    <h5>Información de contacto:</h5>
    <p>Teléfono: @Model.Telefono</p>
    <p>Email: @Model.Email</p>

    @* JQquery, Popper.js, Boostrap.js *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    @* DataTable JS *@
    <script src="~/Scripts//datatables.min.js"></script>
    @* Jquery *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    @* JS DE MAPAS *@
    <script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"
            integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo="
            crossorigin=""></script>
    <script>
        //OJO CON LOS ACENTOS Y LAS Ñ
        $.ajax({
            url: "https://nominatim.openstreetmap.org/search.php",
            data: {
                street: "@Model.Calle",
                city: "@Model.Ciudad",
                state: "@Model.Estado",
                country: "@Model.Pais",
                postalcode: "@Model.CodPostal",
                format: "jsonv2"
            },
            type: "GET",
            success: function (data) {
                console.log("Petición OK!");
                console.log(data); // Aquí puedes hacer lo que quieras con los datos recibidos
                var latitud = data[0].lat;
                var longitud = data[0].lon;
                var map = L.map('map').setView([latitud, longitud], 17);
                L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
                    maxZoom: 19,
                    attribution: '&copy; <a href="http://www.openstreetmap.org/copyright">OpenStreetMap</a>'
                }).addTo(map);

                L.marker([latitud, longitud]).addTo(map)
                    /*.bindPopup('A pretty CSS popup.<br> Easily customizable.')*/
                    .openPopup();
            },
            error: function (xhr, status, error) {
                console.log("Error:", error);
            }
        });
    </script>
</body>

