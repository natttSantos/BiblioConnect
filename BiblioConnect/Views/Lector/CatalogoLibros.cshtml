
@{ ViewBag.Title = "Categoria";
    Layout = "~/Views/Shared/_Layout.cshtml"; }


<head>
    <head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
        @* Boostrap CSS *@
        <link href="~/Content/bootstrap.min.css" rel="stylesheet">
        @* DataTables CSS BÁSICO *@
        <link href="~/Content/datatables.min.css" rel="stylesheet" />
        @* DataTables estilo Boostrap 5 CSS *@
        <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
        @* CSS DE MAPAS *@
        <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
        <link rel="stylesheet" type="text/css" href="~/CSS/Catalogo.css" />
    </head>

    <body>
        <div class="container">
            <div class="row">
                <div class="col-md-3">
                    <section>
                        <div>
                            <h4>Filtros:</h4>
                            <h6>Categoría:</h6>
                            <ul id="categorias-list" class="category-list"></ul>
                        </div>
                        <div>
                            <h6>Idioma:</h6>
                            <ul id="idiomas-list" class="idiomas-list">
                                <li class="listIdiomas">Castellano</li>
                                <li class="listIdiomas">Inglés</li>
                                <li class="listIdiomas">Catalán</li>
                            </ul>
                        </div>
                    </section>
                </div>
                <div class="col-md-9">
                    <div class="row">
                        <form class="d-flex" role="search">
                            <input id="searchInput" class="form-control me-2 custom-input" type="search" placeholder="Título, Autor, ISBN, Editorial" aria-label="Search">
                            <button id="searchButton" class="btn btn-outline-success" type="button" onClick="Search()">Search</button>
                        </form>
                    </div>
                    <div class="row">
                        <div id="libros-list" class="row"></div>
                    </div>
                </div>
            </div>
        </div>
    </body>


    @* JQquery, Popper.js, Boostrap.js *@
    <script src="~/Scripts/jquery-3.7.0.min.js"></script>
    <script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
    <script src="~/Scripts/bootstrap.js"></script>
    @* DataTable JS *@
    <script src="~/Scripts//datatables.min.js"></script>
    @* MAPAS *@
    <script src="~/Scripts/API_mapa.js"></script>


    <script>
    $(document).ready(function () {
        $.ajax({
            url: '@Url.Action("ListarLibro", "Biblioteca")',
            dataType: "json",
            success: function (data) {
                $.each(data.data, function (index, libro) {
                    mostrarInfoLibros(libro);
                });
            },
            error: function () {
                console.log("Error al obtener los libros.");
            }
        });

        $.ajax({
          url: '@Url.Action("ListarCategoria", "Biblioteca")',
          dataType: "json",
          success: function (data) {
            $.each(data.data, function (index, categoria) {
              var listItem = $("<li></li>");
              var nombre = $("<div></div>").addClass("Nombre").text(categoria.Nombre);

              listItem.append(nombre);

              listItem.click(function () {
                $("#categorias-list li").removeClass("selected");
                $(this).addClass("selected");

                var categoriaSeleccionada = $(this).find('.Nombre').text();
                ListarLibroPorCategoria(categoriaSeleccionada);
              });

              $("#categorias-list").append(listItem);
            });
          },
          error: function () {
            console.log("Error al obtener las categorias");
          }
        });
        //Seleccionar un Idioma
        $(".listIdiomas").on("click", function () {
            $("#idiomas-list li").removeClass("selected");
            $(this).addClass("selected");
            var idiomaSeleccionado = $(this).text();
            ListarLibroPorIdioma(idiomaSeleccionado);
        });

        $(window).on('load', function () {
            $("#spinner").hide();
        });
    });

       function ListarLibroPorCategoria(nombreCategoria) {
           $.ajax({
               url: "/Lector/ListarLibroPorCategoria",
               type: "GET",
               data: { nombre: nombreCategoria },
               success: function (data) {
                   $("#libros-list").empty(); // Eliminar contenido previo
                   $.each(data.data, function (index, libro) {
                       mostrarInfoLibros(libro);
                    });
                },
                error: function (error) {
                    console.log("Error al obtener los libros:", error);
                }
            });
        }
        function ListarLibroPorIdioma(idiomaSeleccionado) {
            $.ajax({
                url: "/Lector/ListarLibroPorIdioma",
                type: "GET",
                data: { idioma: idiomaSeleccionado },
                success: function (data) {
                    $("#libros-list").empty();
                    $.each(data.data, function (index, libro) {
                        mostrarInfoLibros(libro);
                    });
                },
                error: function (error) {
                    console.log("Error al obtener los libros según el idioma:", error);
                }
            });
        }


        //Listado Libros por Filtrado
        function Search() {
            var searchInput = document.getElementById('searchInput').value;
            console.log(searchInput)
            $.ajax({
                url: "/Lector/ListarLibroPorFiltrado",
                type: "GET",
                data: { nombre: searchInput },
                success: function (data) {
                    $("#libros-list").empty(); // Eliminar contenido previo
                    $.each(data.data, function (index, idLibro) {
                        $.ajax({
                            url: "/Lector/ObtenerLibro",
                            type: "GET",
                            data: { id: idLibro },
                            success: function (data) {
                                var libro = data.data;
                                libro.Id = idLibro;
                                mostrarInfoLibros(libro);
                            },
                            error: function (error) {
                                console.log("Error al realizar el filtrado", error);
                            }
                        });
                    });
                },
                error: function (error) {
                    console.log("Error al realizar el filtrado", error);
                }
            });
        }
    function mostrarInfoLibros(libro) {
      var divCard = $("<div></div>").addClass("card");
      var listItem = $("<li></li>");
      var link = $("<a></a>").attr("href", '@Url.Action("DetallesLibro", "Lector")?id=' + libro.Id);
      var image = $("<img>").attr("src", libro.Foto);
      var title = $("<div></div>").addClass("title").text(libro.Titulo);
      var distanceElement = $("<div></div>").addClass("distancia");

      getDistance(libro.idBiblioteca)
        .then(function (distance) {
          var distance = distance.toFixed(2); // Redondear el resultado de la distancia a 2 decimales
          distanceElement.html('<i class="fas fa-map-marker-alt"></i> ' + distance + " kilómetros"); // Agregar el icono de mapa junto a la distancia
        })
        .catch(function (error) {
          console.log("Error al obtener la distancia:", error);
          distanceElement.text("Error al obtener la distancia");
        });

      link.append(image);
      divCard.append(listItem);
      divCard.append(link);
      divCard.append(title);
      divCard.append(distanceElement);

      $("#libros-list").append(divCard);
    }

        function getDistance(idBiblioteca) {
            return new Promise(function (resolve, reject) {
                $.ajax({
                    url: "/Lector/ObtenerBiblio",
                    type: "GET",
                    data: { id: idBiblioteca },
                    success: function (data) {
                        var biblio = data.data;
                        //Coordinates Biblioteca
                        getLatLong(biblio.Calle, biblio.Ciudad, biblio.Estado, biblio.Pais, biblio.CodPostal)
                            .then(function (coordinatesLibro) {
                                const lat1 = coordinatesLibro[0];
                                const lon1 = coordinatesLibro[1];
                                //Coordinates User
                                return getUserCurrentPosition()
                                    .then(function (coordinatesUser) {
                                        const lat2 = coordinatesUser[0];
                                        const lon2 = coordinatesUser[1];
                                        const distance = calculateDistance(lat1, lon1, lat2, lon2);
                                        resolve(distance);
                                    });
                            })
                            .catch(function (error) {
                                reject(error);
                            });
                    },
                    error: function (error) {
                        console.log("Error al obtener los datos de la Biblioteca:", error);
                        reject(error);
                    }
                });
            });
        }
    </script>

