        //                    var downloadLink = accessInfo.pdf.webReaderLink;
        //                    // Realiza la descarga del PDF de la muestra
        //                    window.open(downloadLink);
        //                } else {
        //                    console.log('No se encontró una muestra en PDF disponible para este libro.');
        //                }
        //            } else {
        //                console.log('No se encontró ningún libro con el título especificado.');
        //            }
        //        },
        //        error: function () {
        //            alert("Error al obtener la información del libro.");
        //        }
        //    });
        //}


    </script>
</body>

