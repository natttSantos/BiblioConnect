
@{
    ViewBag.Title = "Detalles evento";
}
@using BiblioConnect.Modelo


<head>
        <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/5.15.4/css/all.min.css">
    @* Boostrap CSS *@
    <link href="~/Content/bootstrap.min.css" rel="stylesheet">
    @* DataTables CSS BÁSICO *@
    <link href="~/Content/datatables.min.css" rel="stylesheet" />
    @* DataTables estilo Boostrap 5 CSS *@
    <link href="~/DataTables-1.13.4/css/dataTables.bootstrap5.min.css" rel="stylesheet" />
    @* CSS DE MAPAS *@
    <link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css" integrity="sha256-p4NxAoJBhIIN+hmNHrzRCf9tD/miZyoHS5obTRR9BMY=" crossorigin="" />
    <link rel="stylesheet" type="text/css" href="~/CSS/Mapa.css" />
    <link rel="stylesheet" type="text/css" href="~/CSS/Detalles.css" />
</head>

<body>
    <div class="container">
        <div class="row">
            @* EVENTO *@
            <div class="row">
                <div class="col-md-10">
                    <h3 id="Tipo"></h3>
                    <h6 id="FechaRealizacion"></h6>
                    <h6 id="Hora"></h6>
                    <h6 id="Biblioteca"></h6>
                    <p id="DescripcionEvento"></p>
                </div>
            </div>

            @* AUTOR *@
        <div class="row">
            <div class="col-md-3">
                <img id="FotoAutor" src="#" alt="Imagen">
            </div>
            <div class="col-md-7">
                <h4>Autor</h4>
                <h6 id="NombreAutor"></h6>
                <p id="DescripcionAutor"></p>
            </div>
        </div>
            @* UBICACIÓN *@
            <div class="row">
                <div class="col-md-10">
                    <h4>Ubicación</h4>
                    <div id="map"></div>
                </div>
            </div>
        </div>
    </div>
</body>


@* JQquery, Popper.js, Boostrap.js *@
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/popper.js/2.11.6/umd/popper.min.js"></script>
<script src="~/Scripts/bootstrap.js"></script>
@* DataTable JS *@
<script src="~/Scripts//datatables.min.js"></script>
@* Jquery *@
<script src="~/Scripts/jquery-3.7.0.min.js"></script>
@* JS DE MAPAS *@
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js" integrity="sha256-20nQCchB9co0qIjJZRGuk2/Z9VM+kNiyxNV1lvTlZBo=" crossorigin=""></script>
<script src="~/Scripts/API_mapa.js"></script>
<script src="~/Scripts/Fechas.js"></script>

<script>
    $(document).ready(function () {
            var IdBiblioteca;

            $.ajax({
                url: "/Lector/ObtenerEvento",
                type: "GET",
                data: { id: @Model },
                success: function (data) {
                    var evento = data.data;
                    $("#FotoAutor").attr("src", evento.Foto);
                    $("#NombreAutor").text(evento.NombreAutor);
                    $("#Tipo").text(evento.Tipo);
                    $("#Hora").text(evento.HoraInicio + "-" + evento.HoraFin);
                    $("#FechaRealizacion").text(formatDateToReadable(evento.FechaRealizacion));
                    $("#DescripcionAutor").text(evento.DescripcionAutor);
                    $("#DescripcionEvento").text(evento.DescripcionEvento);
                    IdBiblioteca = evento.idBiblioteca;

                    getBiblioteca(IdBiblioteca);
                },
                error: function (error) {
                    console.log("Error al obtener los datos del libro:", error);
                }
            });


            //Navigate to Perfil Biblioteca
            $("#btnBiblioteca").on("click", function () {
                if (IdBiblioteca) {
                    window.location.href = "/Biblioteca/Perfil?id=" + IdBiblioteca;
                }
            });
        });

        function getBiblioteca(idBiblioteca) {
            $.ajax({
                url: "/Lector/ObtenerBiblio",
                type: "GET",
                data: { id: idBiblioteca },
                success: function (data) {
                    var biblio = data.data;
                    $("#Biblioteca").text(biblio.Nombre);
                    //Mostrar mapa
                    getLatLong(biblio.Calle, biblio.Ciudad, biblio.Estado, biblio.Pais, biblio.CodPostal)
                        .then(function (coordinatesLibro) {
                            const lat = coordinatesLibro[0];
                            const lon = coordinatesLibro[1];
                            mostrarMapa(lat, lon);
                        })
                },
                error: function (error) {
                    console.log("Error al obtener los datos de la Biblioteca:", error);
                }
            });
        }
</script>